+def segmentation_validation(model, data_loader, device, threshold=0.5):
+    model.eval()
+    dice_scores = []
+    iou_scores = []
+    inside_means = []
+    outside_means = []
+    eps = 1e-6
+
+    with torch.no_grad():
+        for samples, image_ids, targets, masks in data_loader:
+            samples = samples.to(device, non_blocking=True)
+            masks = masks.to(device, non_blocking=True).float()
+            outputs = model(samples, return_patch_tokens=True)
+            seg_logits = outputs["seg_logits"]
+            target_masks = F.interpolate(masks, size=seg_logits.shape[-2:], mode="nearest")
+            target_masks = (target_masks > 0.5).float()
+            probs = torch.sigmoid(seg_logits)
+            preds = (probs > threshold).float()
+
+            intersection = (preds * target_masks).sum(dim=(1, 2, 3))
+            pred_area = preds.sum(dim=(1, 2, 3))
+            target_area = target_masks.sum(dim=(1, 2, 3))
+            union = pred_area + target_area - intersection
+
+            dice_scores.append(((2.0 * intersection + eps) / (pred_area + target_area + eps)).cpu())
+            iou_scores.append(((intersection + eps) / (union + eps)).cpu())
+
+            inside = (probs * target_masks).sum(dim=(1, 2, 3)) / (target_area + eps)
+            outside_area = (1.0 - target_masks).sum(dim=(1, 2, 3))
+            outside = (probs * (1.0 - target_masks)).sum(dim=(1, 2, 3)) / (outside_area + eps)
+            inside_means.append(inside.cpu())
+            outside_means.append(outside.cpu())
+
+    if not dice_scores:
+        return {"seg_dice": 0.0, "seg_iou": 0.0, "seg_inside": 0.0, "seg_outside": 0.0}
+
+    seg_inside = torch.cat(inside_means).mean().item()
+    seg_outside = torch.cat(outside_means).mean().item()
+
+    return {
+        "seg_dice": torch.cat(dice_scores).mean().item(),
+        "seg_iou": torch.cat(iou_scores).mean().item(),
+        "seg_inside": seg_inside,
+        "seg_outside": seg_outside,
+        "seg_inside_outside_gap": seg_inside - seg_outside,
+    }
+
+
+# Classification validation function for multitask dataset with masks
+@torch.no_grad()
+def classification_validation_with_masks(model, data_loader, device, num_class):
+    criterion = torch.nn.CrossEntropyLoss()
+    model.eval()
+
+    prediction_list = []
+    prediction_decode_list = []
+    true_label_decode_list = []
+    true_label_onehot_list = []
+
+    total_loss = 0.0
+    count = 0
+
+    for samples, image_ids, targets, masks in data_loader:
+        samples = samples.to(device, non_blocking=True)
+        targets = targets.to(device, non_blocking=True)
+
+        outputs = model(samples)
+        loss = criterion(outputs, targets)
+
+        probs = torch.softmax(outputs, dim=1)
+        preds = probs.argmax(dim=1)
+        true_onehot = F.one_hot(targets.to(torch.int64), num_classes=num_class)
+
+        total_loss += loss.item() * samples.shape[0]
+        count += samples.shape[0]
+
+        prediction_list.extend(probs.detach().cpu().numpy())
+        prediction_decode_list.extend(preds.detach().cpu().numpy())
+        true_label_decode_list.extend(targets.detach().cpu().numpy())
+        true_label_onehot_list.extend(true_onehot.detach().cpu().numpy())
+
+    prediction_array = np.array(prediction_list)
+    prediction_decode_array = np.array(prediction_decode_list)
+    true_label_decode_array = np.array(true_label_decode_list)
+    true_label_onehot_array = np.array(true_label_onehot_list)
+
+    metrics = {
+        "loss": total_loss / max(count, 1),
+        "balanced_accuracy": balanced_accuracy_score(true_label_decode_array, prediction_decode_array),
+        "accuracy": accuracy_score(true_label_decode_array, prediction_decode_array),
+        "weighted_f1": f1_score(true_label_decode_array, prediction_decode_array, average="weighted", zero_division=0),
+        "recall_macro": recall_score(true_label_decode_array, prediction_decode_array, average="macro", zero_division=0),
+        "recall_weighted": recall_score(true_label_decode_array, prediction_decode_array, average="weighted", zero_division=0),
+    }
+
+    try:
+        metrics["auc_roc"] = roc_auc_score(
+            true_label_onehot_array,
+            prediction_array,
+            multi_class="ovr",
+            average="macro",
+        )
+    except Exception:
+        metrics["auc_roc"] = float("nan")
+
+    return metrics
+
