+class UniMask_Dataset(Dataset):
+    """Returns image, id, label, lesion mask, feature masks [2,H,W], has_feat.
+
+    Channel 0 MEL, channel 1 NV. Zeros when the row carries no feature mask.
+    All masks pass through the same paired transform so rotation and flip
+    stay locked to the image.
+    """
+
+    def __init__(
+        self,
+        df: pd.DataFrame,
+        root,
+        train=False,
+        val=False,
+        test=False,
+        paired_transforms=None,
+        binary=False,
+        data_percent=1.0,
+        image_key="image_rel_path",
+        mask_key="mask_rel_path",
+        image_id_key="image_id",
+        feat_mel_key="feat_mel_rel_path",
+        feat_nv_key="feat_nv_rel_path",
+        feat_only=False,
+    ):
+        if train:
+            self.df = df[df["split"] == "train"].copy()
+            self.df = self.df.head(int(len(self.df) * data_percent))
+        elif val:
+            self.df = df[df["split"] == "val"].copy()
+        elif test:
+            self.df = df[df["split"] == "test"].copy()
+        else:
+            self.df = df.copy()
+
+        if feat_only:
+            if "has_feat" not in self.df.columns:
+                raise ValueError("feat_only requires a has_feat column")
+            self.df = self.df[self.df["has_feat"] == 1].reset_index(drop=True)
+
+        self.root = Path(root)
+        self.binary = binary
+        self.image_key = image_key
+        self.mask_key = mask_key
+        self.image_id_key = image_id_key
+        self.feat_mel_key = feat_mel_key
+        self.feat_nv_key = feat_nv_key
+        self.paired_transforms = paired_transforms
+
+    def _open_mask(self, rel, size):
+        if rel is None or (isinstance(rel, float) and pd.isna(rel)) or str(rel) == "":
+            return Image.new("L", size, 0), False
+        p = (self.root / str(rel)).resolve()
+        if not p.exists():
+            return Image.new("L", size, 0), False
+        return Image.open(p).convert("L"), True
+
+    def __getitem__(self, index):
+        row = self.df.iloc[index]
+        image_path = (self.root / str(row[self.image_key])).resolve()
+        try:
+            image = Image.open(image_path).convert("RGB")
+        except IOError as e:
+            raise RuntimeError(f"Failed to open image: {image_path}") from e
+
+        mask, _ = self._open_mask(row[self.mask_key], image.size)
+        fm, ok_m = self._open_mask(row.get(self.feat_mel_key, ""), image.size)
+        fn, ok_n = self._open_mask(row.get(self.feat_nv_key, ""), image.size)
+        has_feat = int(bool(row.get("has_feat", 0)) and (ok_m or ok_n))
+
+        if self.paired_transforms is not None:
+            image, masks = self.paired_transforms(image, [mask, fm, fn])
+        else:
+            image = TF.to_tensor(image)
+            masks = torch.stack([(TF.to_tensor(m) > 0.5).float()[0]
+                                 for m in (mask, fm, fn)])
+
+        lesion = masks[0:1]
+        feat = masks[1:3]
+
+        y = row["binary_label"] if self.binary else row["label"]
+        image_id = row[self.image_id_key] if self.image_id_key in row \
+            else Path(str(row[self.image_key])).stem
+        return image, str(image_id), y, lesion, feat, has_feat
+
+    def __len__(self):
+        return len(self.df)
+
+    def count_label(self):
+        col = "binary_label" if self.binary else "label"
+        return self.df[col].value_counts().sort_index()
