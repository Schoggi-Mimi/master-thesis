+            key = key[len("module."):]
+        if key.startswith("backbone.") or key.startswith("seg_head."):
+            new_state_dict[key] = value
+        else:
+            new_state_dict[f"backbone.{key}"] = value
+
+    msg = multitask_model.load_state_dict(new_state_dict, strict=False)
+    print(
+        f"Loaded init checkpoint from {ckpt_path}: "
+        f"missing_keys={len(getattr(msg, 'missing_keys', []))}, "
+        f"unexpected_keys={len(getattr(msg, 'unexpected_keys', []))}"
+    )
+
