+        state_dict = model.state_dict()
+        all_keys = [key for key in list(checkpoint_model.keys()) if key.startswith('encoder.')]
+        for key in all_keys:
+            new_key = key.replace('encoder.', '')
+            checkpoint_model[new_key] = checkpoint_model[key]
