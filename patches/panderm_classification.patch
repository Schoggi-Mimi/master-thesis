+        if c in df.columns
+    ]
+    print(df[df["split"] == "train"][show_cols].head(max_rows).to_string(index=False))
+
+    for name, ds in [("train", ds_train), ("val", ds_val), ("test", ds_test)]:
+        print(f"DEBUG {name} samples:")
+        for idx in range(min(max_rows, len(ds))):
+            item = ds[idx]
+            image = item["image"]
+            mask = item["mask"]
+            label = item["label"]
+            image_id = item["image_id"]
+            print(
+                f"  idx={idx} id={image_id} label={label} "
+                f"image_shape={tuple(image.shape)} "
+                f"image_mean={image.float().mean().item():.4f} "
+                f"image_std={image.float().std().item():.4f} "
+                f"mask_shape={tuple(mask.shape)} "
+                f"mask_mean={mask.float().mean().item():.4f}"
+            )
+
+def build_criterion(args, train_df, device):
+    mixup_active = args.mixup > 0 or args.cutmix > 0 or args.cutmix_minmax is not None
+
+    if mixup_active:
+        return SoftTargetCrossEntropy().to(device)
+
+    if args.class_weights:
+        label_counts = train_df["label"].value_counts().sort_index()
+        counts = np.array([label_counts.get(i, 1) for i in range(args.nb_classes)], dtype=np.float32)
+        weights = counts.sum() / np.maximum(counts, 1.0)
+        weights = weights / weights.mean()
+        class_weights = torch.tensor(weights, dtype=torch.float32, device=device)
+
+        if args.smoothing > 0:
+            print("Using weighted CE without label smoothing.")
+        return nn.CrossEntropyLoss(weight=class_weights).to(device)
+
+    if args.smoothing > 0:
+        return LabelSmoothingCrossEntropy(smoothing=args.smoothing).to(device)
+
+    return nn.CrossEntropyLoss().to(device)
+
