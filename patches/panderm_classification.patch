+class SoftMaskWrapper(nn.Module):
+    """
+    Wrap a classifier so inputs are lesion-focused before entering the model.
+
+    soft_mask_mode:
+        - "blend": x' = x * (bg_strength + (1-bg_strength) * mask)
+        - "concat_blend": not used here, kept for future extension
+    """
+
+    def __init__(self, backbone, bg_strength=0.25, soft_mask_mode="blend", disable_softmask=False):
+        super().__init__()
+        self.backbone = backbone
+        self.bg_strength = bg_strength
+        self.soft_mask_mode = soft_mask_mode
+        self.disable_softmask = disable_softmask
+
+    def forward(self, x, mask=None):
+        if mask is not None and not self.disable_softmask:
+            if mask.dim() == 3:
+                mask = mask.unsqueeze(1)
+            mask = mask.float()
+            if mask.shape[-2:] != x.shape[-2:]:
+                mask = torch.nn.functional.interpolate(
+                    mask, size=x.shape[-2:], mode="nearest"
+                )
+
+            # x is already normalized. Multiplying by weight blends suppressed
+            # background toward normalized zero, i.e. approximately dataset mean.
+            weight = self.bg_strength + (1.0 - self.bg_strength) * mask
+            x = x * weight
+
+        return self.backbone(x)
+
+
+class SoftMaskDataset(torch.utils.data.Dataset):
+    """
+    Adapts UniMask_Dataset output to the expected classifier training format:
+    train loop expects: samples, _, targets
+    evaluate loop expects: images, image_name, target
+    """
+
+    def __init__(self, base_dataset):
+        self.base_dataset = base_dataset
+
+    def __len__(self):
+        return len(self.base_dataset)
+
+    def __getitem__(self, idx):
+        image, image_id, label, mask = self.base_dataset[idx]
+        return {"image": image, "image_id": image_id, "label": label, "mask": mask}
+
+    def count_label(self):
+        return self.base_dataset.count_label()
+
+
+def softmask_collate_fn(batch):
+    images = torch.stack([b["image"] for b in batch], dim=0)
+    labels = torch.tensor([b["label"] for b in batch], dtype=torch.long)
+    ids = [b["image_id"] for b in batch]
+    masks = torch.stack([b["mask"] for b in batch], dim=0)
+    return images, ids, labels, masks
