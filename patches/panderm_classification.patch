+# Helper to summarize missing/unexpected keys from load_state_dict
+def summarize_incompatible_keys(msg, max_examples=20):
+    missing = list(getattr(msg, "missing_keys", []))
+    unexpected = list(getattr(msg, "unexpected_keys", []))
+
+    summary = f"missing_keys={len(missing)}, unexpected_keys={len(unexpected)}"
+
+    if missing:
+        summary += f"\n  missing examples: {missing[:max_examples]}"
+    if unexpected:
+        summary += f"\n  unexpected examples: {unexpected[:max_examples]}"
+
+    return summary
