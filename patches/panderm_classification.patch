+import math
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from einops import rearrange
+
+try:
+    from .modeling_finetune import \
+        DropPath  # prefer package-relative import to avoid duplicate module loading
+except Exception:
+    from models.modeling_finetune import DropPath  # fallback when classification root is injected into sys.path
+
+from external.Chefer.modules.layers_ours import GELU as RelGELU
+from external.Chefer.modules.layers_ours import Add as RelAdd
+from external.Chefer.modules.layers_ours import Clone as RelClone
+from external.Chefer.modules.layers_ours import Dropout as RelDropout
+from external.Chefer.modules.layers_ours import LayerNorm as RelLayerNorm
+from external.Chefer.modules.layers_ours import Linear as RelLinear
+from external.Chefer.modules.layers_ours import Softmax as RelSoftmax
+from external.Chefer.modules.layers_ours import einsum as RelEinsum
+
+
+class RelPropMlp(nn.Module):
+    def __init__(self, in_features, hidden_features=None, out_features=None, drop=0.0):
+        super().__init__()
+        out_features = out_features or in_features
+        hidden_features = hidden_features or in_features
+        self.fc1 = RelLinear(in_features, hidden_features)
+        self.act = RelGELU()
+        self.fc2 = RelLinear(hidden_features, out_features)
+        self.drop = RelDropout(drop)
+
+    def forward(self, x):
+        x = self.fc1(x)
+        x = self.act(x)
+        x = self.fc2(x)
+        x = self.drop(x)
+        return x
+
+    def relprop(self, cam, **kwargs):
+        cam = self.drop.relprop(cam, **kwargs)
+        cam = self.fc2.relprop(cam, **kwargs)
+        cam = self.act.relprop(cam, **kwargs)
+        cam = self.fc1.relprop(cam, **kwargs)
+        return cam
+
+
+class RelPropAttention(nn.Module):
+    """
+    PanDerm-compatible attention block with Chefer-style relprop structure.
+    This is for phase-1 inference/explanation testing.
+    """
+
+    def __init__(
+        self,
+        dim,
+        num_heads=8,
+        qkv_bias=False,
+        qk_scale=None,
+        attn_drop=0.0,
+        proj_drop=0.0,
+        window_size=None,
+        attn_head_dim=None,
+    ):
+        super().__init__()
+        self.num_heads = num_heads
+        head_dim = dim // num_heads
+        if attn_head_dim is not None:
+            head_dim = attn_head_dim
+        all_head_dim = head_dim * self.num_heads
+        self.scale = qk_scale or head_dim ** -0.5
+
+        self.qkv = RelLinear(dim, all_head_dim * 3, bias=qkv_bias)
+        if qkv_bias:
+            self.q_bias = nn.Parameter(torch.zeros(all_head_dim))
+            self.v_bias = nn.Parameter(torch.zeros(all_head_dim))
+        else:
+            self.q_bias = None
+            self.v_bias = None
+
+        self.window_size = window_size
+        if window_size is not None:
+            self.num_relative_distance = (2 * window_size[0] - 1) * (2 * window_size[1] - 1) + 3
+            self.relative_position_bias_table = nn.Parameter(
+                torch.zeros(self.num_relative_distance, num_heads)
+            )
+
+            coords_h = torch.arange(window_size[0])
+            coords_w = torch.arange(window_size[1])
+            coords = torch.stack(torch.meshgrid([coords_h, coords_w], indexing="ij"))
+            coords_flatten = torch.flatten(coords, 1)
+            relative_coords = coords_flatten[:, :, None] - coords_flatten[:, None, :]
+            relative_coords = relative_coords.permute(1, 2, 0).contiguous()
+            relative_coords[:, :, 0] += window_size[0] - 1
+            relative_coords[:, :, 1] += window_size[1] - 1
+            relative_coords[:, :, 0] *= 2 * window_size[1] - 1
+
+            relative_position_index = torch.zeros(
+                size=(window_size[0] * window_size[1] + 1,) * 2,
+                dtype=relative_coords.dtype,
+            )
+            relative_position_index[1:, 1:] = relative_coords.sum(-1)
+            relative_position_index[0, 0:] = self.num_relative_distance - 3
+            relative_position_index[0:, 0] = self.num_relative_distance - 2
+            relative_position_index[0, 0] = self.num_relative_distance - 1
+            self.register_buffer("relative_position_index", relative_position_index)
+        else:
+            self.relative_position_bias_table = None
+            self.relative_position_index = None
+
+        self.matmul1 = RelEinsum("bhid,bhjd->bhij")
+        self.matmul2 = RelEinsum("bhij,bhjd->bhid")
+
+        self.softmax = RelSoftmax(dim=-1)
+        self.attn_drop = RelDropout(attn_drop)
+        self.proj = RelLinear(all_head_dim, dim)
+        self.proj_drop = RelDropout(proj_drop)
+
+        self.attn = None
+        self.attn_cam = None
+        self.attn_gradients = None
+        self.v = None
+        self.v_cam = None
+
+    def _get_rel_pos_bias(self):
+        if self.relative_position_bias_table is None or self.relative_position_index is None:
+            return None
+        rel_pos = self.relative_position_bias_table[self.relative_position_index.view(-1)]
+        rel_pos = rel_pos.view(
+            self.window_size[0] * self.window_size[1] + 1,
+            self.window_size[0] * self.window_size[1] + 1,
+            -1,
+        )
+        return rel_pos.permute(2, 0, 1).contiguous()
+
+    def save_attn(self, attn):
+        self.attn = attn
+
+    def get_attn(self):
+        return self.attn
+
+    def save_attn_cam(self, cam):
+        self.attn_cam = cam
+
+    def get_attn_cam(self):
+        return self.attn_cam
+
+    def save_attn_gradients(self, grad):
+        self.attn_gradients = grad
+
+    def get_attn_gradients(self):
+        return self.attn_gradients
+
+    def save_v(self, v):
+        self.v = v
+
+    def get_v(self):
+        return self.v
+
+    def save_v_cam(self, cam):
+        self.v_cam = cam
+
+    def get_v_cam(self):
+        return self.v_cam
+
+    def _sync_qkv_bias(self):
+        if self.q_bias is None or self.v_bias is None or self.qkv.bias is None:
+            return
+        zero_bias = torch.zeros_like(self.q_bias, requires_grad=False)
+        combined_bias = torch.cat((self.q_bias, zero_bias, self.v_bias))
+        with torch.no_grad():
+            self.qkv.bias.copy_(combined_bias)
+
+    def forward(self, x):
+        B, N, C = x.shape
+
+        if self.q_bias is not None:
+            self._sync_qkv_bias()
+        qkv = self.qkv(x)
+
+        qkv = qkv.reshape(B, N, 3, self.num_heads, -1).permute(2, 0, 3, 1, 4)
+        q, k, v = qkv[0], qkv[1], qkv[2]
+
+        self.save_v(v)
+
+        dots = self.matmul1([q, k]) * self.scale
+
+        rel_pos = self._get_rel_pos_bias()
+        if rel_pos is not None:
+            dots = dots + rel_pos.unsqueeze(0)
+
+        attn = self.softmax(dots)
+        attn = self.attn_drop(attn)
+
+        self.save_attn(attn)
+        if attn.requires_grad:
+            attn.register_hook(self.save_attn_gradients)
+
+        out = self.matmul2([attn, v])
+        out = rearrange(out, "b h n d -> b n (h d)")
+
+        out = self.proj(out)
+        out = self.proj_drop(out)
+        return out
+
+    def relprop(self, cam, **kwargs):
+        cam = self.proj_drop.relprop(cam, **kwargs)
+        cam = self.proj.relprop(cam, **kwargs)
+        cam = rearrange(cam, "b n (h d) -> b h n d", h=self.num_heads)
+
+        cam_attn, cam_v = self.matmul2.relprop(cam, **kwargs)
+        cam_attn /= 2
+        cam_v /= 2
+
+        self.save_v_cam(cam_v)
+        self.save_attn_cam(cam_attn)
+
+        cam_attn = self.attn_drop.relprop(cam_attn, **kwargs)
+        cam_attn = self.softmax.relprop(cam_attn, **kwargs)
+
+        cam_q, cam_k = self.matmul1.relprop(cam_attn, **kwargs)
+        cam_q /= 2
+        cam_k /= 2
+
+        cam_qkv = rearrange(
+            [cam_q, cam_k, cam_v],
+            "qkv b h n d -> b n (qkv h d)",
+            qkv=3,
+            h=self.num_heads,
+        )
+
+        return self.qkv.relprop(cam_qkv, **kwargs)
+
+
+class RelPropBlock(nn.Module):
+    def __init__(
+        self,
+        dim,
+        num_heads,
+        mlp_ratio=4.0,
+        qkv_bias=False,
+        qk_scale=None,
+        drop=0.0,
+        attn_drop=0.0,
+        init_values=None,
+        drop_path_prob=0.0,
+        window_size=None,
+        attn_head_dim=None,
+    ):
+        super().__init__()
+        self.norm1 = RelLayerNorm(dim, eps=1e-6)
+        self.attn = RelPropAttention(
+            dim=dim,
+            num_heads=num_heads,
+            qkv_bias=qkv_bias,
+            qk_scale=qk_scale,
+            attn_drop=attn_drop,
+            proj_drop=drop,
+            window_size=window_size,
+            attn_head_dim=attn_head_dim,
+        )
+        self.norm2 = RelLayerNorm(dim, eps=1e-6)
+        mlp_hidden_dim = int(dim * mlp_ratio)
+        self.mlp = RelPropMlp(dim, hidden_features=mlp_hidden_dim, out_features=dim, drop=drop)
+
+        self.gamma_1 = nn.Parameter(init_values * torch.ones(dim), requires_grad=True) if init_values else None
+        self.gamma_2 = nn.Parameter(init_values * torch.ones(dim), requires_grad=True) if init_values else None
+
+        self.drop_path = DropPath(drop_path_prob) if drop_path_prob > 0.0 else nn.Identity()
+
+        self.add1 = RelAdd()
+        self.add2 = RelAdd()
+        self.clone1 = RelClone()
+        self.clone2 = RelClone()
+
+    def forward(self, x):
+        x1, x2 = self.clone1(x, 2)
+        attn_out = self.attn(self.norm1(x2))
+        if self.gamma_1 is not None:
+            attn_out = self.gamma_1 * attn_out
+        attn_out = self.drop_path(attn_out)
+        x = self.add1([x1, attn_out])
+
+        x1, x2 = self.clone2(x, 2)
+        mlp_out = self.mlp(self.norm2(x2))
+        if self.gamma_2 is not None:
+            mlp_out = self.gamma_2 * mlp_out
+        mlp_out = self.drop_path(mlp_out)
+        x = self.add2([x1, mlp_out])
+        return x
+
+    def relprop(self, cam, **kwargs):
+        cam1, cam2 = self.add2.relprop(cam, **kwargs)
+        if self.gamma_2 is not None:
+            cam2 = cam2 * self.gamma_2
+        cam2 = self.mlp.relprop(cam2, **kwargs)
+        cam2 = self.norm2.relprop(cam2, **kwargs)
+        cam = self.clone2.relprop((cam1, cam2), **kwargs)
+
+        cam1, cam2 = self.add1.relprop(cam, **kwargs)
+        if self.gamma_1 is not None:
+            cam2 = cam2 * self.gamma_1
+        cam2 = self.attn.relprop(cam2, **kwargs)
+        cam2 = self.norm1.relprop(cam2, **kwargs)
+        cam = self.clone1.relprop((cam1, cam2), **kwargs)
+        return cam
+
+
+class PanDermRelPropWrapper(nn.Module):
+    """
+    Wrap an already fine-tuned PanDerm model with relprop-capable blocks.
+    Phase 1: inference-only testing with the existing checkpoint.
+    """
+
+    def __init__(self, base_model: nn.Module):
+        super().__init__()
+        self.patch_embed = base_model.patch_embed
+        self.cls_token = base_model.cls_token
+        self.pos_embed = getattr(base_model, "pos_embed", None)
+        self.pos_drop = getattr(base_model, "pos_drop", nn.Identity())
+        self._last_token_features = None
+
+        self.norm = None
+        base_norm = getattr(base_model, "norm", None)
+        if base_norm is not None and hasattr(base_norm, "normalized_shape") and hasattr(base_norm, "eps"):
+            dim = base_norm.normalized_shape[0]
+            self.norm = RelLayerNorm(dim, eps=base_norm.eps)
+            self.norm.load_state_dict(base_norm.state_dict())
+
+        self.fc_norm = None
+        base_fc_norm = getattr(base_model, "fc_norm", None)
+        if base_fc_norm is not None and hasattr(base_fc_norm, "normalized_shape") and hasattr(base_fc_norm, "eps"):
+            dim = base_fc_norm.normalized_shape[0]
+            self.fc_norm = RelLayerNorm(dim, eps=base_fc_norm.eps)
+            self.fc_norm.load_state_dict(base_fc_norm.state_dict())
+
+        self.use_mean_pooling = self.fc_norm is not None
+
+        in_features = base_model.head.in_features
+        out_features = base_model.head.out_features
+        self.head = RelLinear(in_features, out_features, bias=base_model.head.bias is not None)
+        self.head.weight.data.copy_(base_model.head.weight.data)
+        if base_model.head.bias is not None:
+            self.head.bias.data.copy_(base_model.head.bias.data)
+
+        self.num_patches = base_model.patch_embed.num_patches
+        self.blocks = nn.ModuleList()
+
+        for blk in base_model.blocks:
+            dim = blk.norm1.normalized_shape[0]
+            num_heads = blk.attn.num_heads
+            mlp_ratio = blk.mlp.fc1.out_features / blk.mlp.fc1.in_features
+            qkv_bias = getattr(blk.attn, "q_bias", None) is not None or getattr(blk.attn.qkv, "bias", None) is not None
+            init_values = None
+            if hasattr(blk, "gamma_1") and blk.gamma_1 is not None:
+                init_values = float(blk.gamma_1.detach().mean().cpu())
+
+            window_size = getattr(blk.attn, "window_size", None)
+            attn_head_dim = None
+            if hasattr(blk.attn, "qkv"):
+                total_qkv = blk.attn.qkv.weight.shape[0] // 3
+                head_dim = total_qkv // num_heads
+                if head_dim * num_heads != dim:
+                    attn_head_dim = head_dim
+
+            rel_blk = RelPropBlock(
+                dim=dim,
+                num_heads=num_heads,
+                mlp_ratio=mlp_ratio,
+                qkv_bias=qkv_bias,
+                qk_scale=getattr(blk.attn, "scale", None),
+                drop=getattr(getattr(blk.attn, "proj_drop", None), "p", 0.0),
+                attn_drop=getattr(getattr(blk.attn, "attn_drop", None), "p", 0.0),
+                init_values=init_values,
+                drop_path_prob=getattr(getattr(blk, "drop_path", None), "drop_prob", 0.0) or 0.0,
+                window_size=window_size,
+                attn_head_dim=attn_head_dim,
+            )
+            self.blocks.append(rel_blk)
+
+        self._copy_weights_from_base(base_model)
+
+    def _copy_weights_from_base(self, base_model):
+        for rel_blk, blk in zip(self.blocks, base_model.blocks):
+            rel_blk.norm1.load_state_dict(blk.norm1.state_dict())
+            rel_blk.norm2.load_state_dict(blk.norm2.state_dict())
+
+            rel_blk.mlp.fc1.weight.data.copy_(blk.mlp.fc1.weight.data)
+            rel_blk.mlp.fc1.bias.data.copy_(blk.mlp.fc1.bias.data)
+            rel_blk.mlp.fc2.weight.data.copy_(blk.mlp.fc2.weight.data)
+            rel_blk.mlp.fc2.bias.data.copy_(blk.mlp.fc2.bias.data)
+
+            rel_blk.attn.qkv.weight.data.copy_(blk.attn.qkv.weight.data)
+
+            if hasattr(blk.attn, "q_bias") and blk.attn.q_bias is not None:
+                rel_blk.attn.q_bias.data.copy_(blk.attn.q_bias.data)
+                rel_blk.attn.v_bias.data.copy_(blk.attn.v_bias.data)
+            elif getattr(blk.attn.qkv, "bias", None) is not None:
+                qkv_bias = blk.attn.qkv.bias.data
+                dim = qkv_bias.shape[0] // 3
+                rel_blk.attn.q_bias.data.copy_(qkv_bias[:dim])
+                rel_blk.attn.v_bias.data.copy_(qkv_bias[2 * dim:])
+            
+            rel_blk.attn._sync_qkv_bias()
+            rel_blk.attn.proj.weight.data.copy_(blk.attn.proj.weight.data)
+            rel_blk.attn.proj.bias.data.copy_(blk.attn.proj.bias.data)
+
+            if getattr(rel_blk.attn, "relative_position_bias_table", None) is not None and \
+               getattr(blk.attn, "relative_position_bias_table", None) is not None:
+                rel_blk.attn.relative_position_bias_table.data.copy_(blk.attn.relative_position_bias_table.data)
+
+            if hasattr(blk, "gamma_1") and blk.gamma_1 is not None and rel_blk.gamma_1 is not None:
+                rel_blk.gamma_1.data.copy_(blk.gamma_1.data)
+            if hasattr(blk, "gamma_2") and blk.gamma_2 is not None and rel_blk.gamma_2 is not None:
+                rel_blk.gamma_2.data.copy_(blk.gamma_2.data)
+
+    def forward_features(self, x):
+        x = self.patch_embed(x)
+        B = x.shape[0]
+        cls_tokens = self.cls_token.expand(B, -1, -1)
+        x = torch.cat((cls_tokens, x), dim=1)
+        if self.pos_embed is not None:
+            x = x + self.pos_embed
+        x = self.pos_drop(x)
+
+        for blk in self.blocks:
+            x = blk(x)
+
+        if self.norm is not None:
+            x = self.norm(x)
+        return x
+
+    def forward(self, x):
+        x = self.forward_features(x)
+        self._last_token_features = x
+        if self.use_mean_pooling:
+            pooled = x[:, 1:, :].mean(dim=1)
+            pooled = self.fc_norm(pooled)
+        else:
+            pooled = x[:, 0]
+        return self.head(pooled)
+
+    def relprop(self, cam, method="transformer_attribution", start_layer=0, **kwargs):
+        cam = self.head.relprop(cam, **kwargs)
+
+        if self.use_mean_pooling:
+            B, D = cam.shape
+            if self._last_token_features is None:
+                raise RuntimeError("relprop() requires a forward pass before relevance propagation.")
+
+            patch_tokens = self._last_token_features[:, 1:, :]
+            if self.fc_norm is not None:
+                cam = self.fc_norm.relprop(cam, **kwargs)
+
+            # Improved mean-pooling relevance redistribution:
+            # distribute relevance proportionally to positive token contribution
+            # for each feature dimension instead of uniform spreading.
+            token_weights = patch_tokens.clamp(min=0)
+            weight_sums = token_weights.sum(dim=1, keepdim=True)
+
+            fallback = torch.full_like(token_weights, 1.0 / self.num_patches)
+            norm_weights = torch.where(
+                weight_sums > 1e-8,
+                token_weights / (weight_sums + 1e-8),
+                fallback,
+            )
+
+            token_cam = torch.zeros(
+                B, 1 + self.num_patches, D, device=cam.device, dtype=cam.dtype
+            )
+            token_cam[:, 1:, :] = norm_weights * cam.unsqueeze(1)
+            cam = token_cam
+        else:
+            B, D = cam.shape
+            token_cam = torch.zeros(
+                B, 1 + self.num_patches, D, device=cam.device, dtype=cam.dtype
+            )
+            token_cam[:, 0, :] = cam
+            cam = token_cam
+
+        if self.norm is not None:
+            cam = self.norm.relprop(cam, **kwargs)
+
+        for blk in reversed(self.blocks):
+            cam = blk.relprop(cam, **kwargs)
+
+        if method == "full":
+            return cam
+
+        if method == "transformer_attribution":
+            cams = []
+            for blk in self.blocks:
+                grad = blk.attn.get_attn_gradients()
+                attn_cam = blk.attn.get_attn_cam()
+                if grad is None or attn_cam is None:
+                    continue
+                layer_cam = (grad * attn_cam).clamp(min=0).mean(dim=1)
+                cams.append(layer_cam)
+
+            if len(cams) == 0:
+                raise RuntimeError("No attention CAMs collected. Run forward + backward before relprop().")
+
+            num_tokens = cams[0].shape[-1]
+            eye = torch.eye(num_tokens, device=cams[0].device).unsqueeze(0).expand(cams[0].shape[0], -1, -1)
+            mats = [c + eye for c in cams]
+            joint = mats[start_layer]
+            for i in range(start_layer + 1, len(mats)):
+                joint = mats[i].bmm(joint)
+            return joint[:, 0, 1:]
+
+        return cam
+
+
+def build_panderm_relprop_from_model(base_model: nn.Module) -> PanDermRelPropWrapper:
+    rel_model = PanDermRelPropWrapper(base_model)
+    rel_model.eval()
+    return rel_model
