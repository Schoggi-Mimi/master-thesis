+                    saturation=0.05, hue=0.02)(image)
+
+        image = TF.normalize(TF.to_tensor(image), mean=self.mean, std=self.std)
+        out = torch.stack([(self._mask_to_tensor(m) > 0.5).float()[0] for m in masks])
+        return image, out
+
+
+def load_finetuned_checkpoint_if_available(model, ckpt_path):
+    if not ckpt_path:
+        return
+
+    ckpt_path = str(ckpt_path)
+    if not os.path.isfile(ckpt_path):
+        raise FileNotFoundError(f"init_checkpoint not found: {ckpt_path}")
+
+    checkpoint = torch.load(ckpt_path, map_location="cpu")
+    state_dict = checkpoint["model"] if isinstance(checkpoint, dict) and "model" in checkpoint else checkpoint
+    state_dict = state_dict.copy()
+
+    backbone_keys = [key for key in list(state_dict.keys()) if key.startswith("backbone.")]
+    if len(backbone_keys) > 0:
+        for key in backbone_keys:
+            new_key = key.replace("backbone.", "", 1)
+            state_dict[new_key] = state_dict[key]
+        for key in backbone_keys:
+            state_dict.pop(key, None)
+
+    state_dict = remap_norm_keys_for_pooling(state_dict, model)
+
+    msg = model.load_state_dict(state_dict, strict=False)
+    print(
+        f"Loaded finetuned init checkpoint from {ckpt_path}: "
+        f"missing_keys={len(getattr(msg, 'missing_keys', []))}, "
+        f"unexpected_keys={len(getattr(msg, 'unexpected_keys', []))}"
+    )
+
+
+def unpack_model_outputs(outputs):
+    if isinstance(outputs, dict):
+        logits = outputs.get("logits")
+        patch_tokens = outputs.get("patch_tokens")
+        return logits, patch_tokens
+
+    if isinstance(outputs, (tuple, list)):
+        if len(outputs) == 0:
+            raise ValueError("Model returned an empty tuple/list")
+        logits = outputs[0]
+        patch_tokens = outputs[1] if len(outputs) > 1 else None
+        return logits, patch_tokens
+
+    return outputs, None
+
+
+def _unwrap_model(model):
+    return model.module if hasattr(model, "module") else model
+
+
+def validate_patch_tokens_for_grid(model, patch_tokens):
+    base_model = _unwrap_model(model)
+    h, w = base_model.patch_embed.patch_shape
+    expected = h * w
+
+    if patch_tokens.dim() != 3:
+        raise ValueError(f"Expected patch_tokens [B, N, D], got {tuple(patch_tokens.shape)}")
+
+    actual = patch_tokens.shape[1]
+    if actual != expected:
+        raise ValueError(
+            f"Patch token count mismatch. Got {actual}. Expected {expected}. Grid={h}x{w}"
+        )
+    return h, w
+
+
+def minmax_normalize_map(attn_map, eps=1e-6):
+    attn_map = attn_map.float()
+    b = attn_map.shape[0]
+    flat = attn_map.view(b, -1)
+    min_v = flat.min(dim=1, keepdim=True)[0].view(b, 1, 1)
+    max_v = flat.max(dim=1, keepdim=True)[0].view(b, 1, 1)
+    denom = (max_v - min_v).clamp_min(eps)
+    return (attn_map - min_v) / denom
+
+
+def ha_soft_dice_loss(pred, target, eps=1e-6):
+    pred = pred.float()
+    target = target.float()
+    intersection = (pred * target).sum(dim=(1, 2))
+    denom = pred.sum(dim=(1, 2)) + target.sum(dim=(1, 2))
+    dice = (2.0 * intersection + eps) / (denom + eps)
+    return 1.0 - dice.mean()
+
+
+def ha_alignment_loss(pred, target, fp_weight=1.0, eps=1e-6):
+    pred = pred.float()
+    target = target.float()
+
+    inside_mass = (pred * target).sum(dim=(1, 2))
+    outside_mass = (pred * (1.0 - target)).sum(dim=(1, 2))
+
+    target_area = target.sum(dim=(1, 2))
+    background_area = (1.0 - target).sum(dim=(1, 2))
+
+    inside_mean = inside_mass / (target_area + eps)
+    outside_mean = outside_mass / (background_area + eps)
+
+    loss = (1.0 - inside_mean) + fp_weight * outside_mean
+    return loss.mean()
+
+
+def ha_alignment_score(pred, target, fp_weight=1.0, eps=1e-6):
+    pred = pred.float()
+    target = target.float()
+
+    inside_mass = (pred * target).sum(dim=(1, 2))
+    outside_mass = (pred * (1.0 - target)).sum(dim=(1, 2))
+
+    target_area = target.sum(dim=(1, 2))
+    background_area = (1.0 - target).sum(dim=(1, 2))
+
+    inside_mean = inside_mass / (target_area + eps)
+    outside_mean = outside_mass / (background_area + eps)
+
+    score = inside_mean - fp_weight * outside_mean
+    return score.mean()
+
+
+def build_attention_gradcam_map(model, logits, targets, create_graph=False, return_diagnostics=False):
+    """
+    Compute a gradient-weighted attention CAM from the last transformer block.
+
+    Args:
+        model:              The (possibly DDP-wrapped) model.
+        logits:             [B, C] classification logits. Must be on the computation graph.
+        targets:            [B] int64 ground-truth class indices.
+        create_graph:       Pass True during HA training so the second-order gradient
+                            graph is retained for loss.backward(). Pass False during eval.
+        return_diagnostics: If True, return (cam_map, diagnostics_dict).
+                            If False, return cam_map only.
+                            Diagnostics are always detached; cam_map is never detached here.
+
+    Returns:
+        cam_map [B, H, W] float, normalized to [0, 1] per sample.
+        diagnostics dict (only when return_diagnostics=True).
+    """
+    base_model = _unwrap_model(model)
+    h, w = base_model.patch_embed.patch_shape
+
+    target_logits = logits.gather(1, targets.view(-1, 1)).sum()
+
+    attn_module = base_model.blocks[-1].attn
+    attn_tensor = attn_module.last_attn
+
+    if attn_tensor is None:
+        raise ValueError(
+            "last_attn is None. The model did not store attention for the target block. "
+            "Ensure forward() was called with store_attn=True and attn_layer=-1."
+        )
+
+    if not attn_tensor.requires_grad:
+        raise ValueError(
+            "attn_tensor.requires_grad is False. "
+            "Check that the model is in train() mode (or torch.enable_grad() is active) "
+            "and no torch.no_grad() context is wrapping the forward pass."
+        )
+
+    attn_grad = torch.autograd.grad(
+        target_logits,
+        attn_tensor,
+        retain_graph=True,
+        create_graph=create_graph,
+    )[0]
+
+    if attn_grad is None:
+        raise ValueError(
+            "torch.autograd.grad returned None for attn_tensor. "
+            "The attention tensor is not connected to the target logit in the computation graph."
+        )
+
+    mean_flag = bool(getattr(base_model, "use_mean_pooling", False))
+
+    if mean_flag:
+        patch_attn = attn_tensor[:, :, 1:, 1:]   # [B, H, Q, K]
+        patch_grad = attn_grad[:, :, 1:, 1:]     # [B, H, Q, K]
+
+        # weighted[b, h, q, k] is the gradient-weighted attention from query patch q
+        # to key patch k. For lesion localization we want to know which key patches
+        # receive the most attention across all queries. We therefore average over
+        # heads first, then sum over the query dimension (dim=1) to get incoming
+        # attention mass per key patch.
+        weighted = patch_attn * patch_grad        # [B, H, Q, K]
+        weighted = weighted.mean(dim=1)           # [B, Q, K]  (average over heads)
+        cam_vec = F.relu(weighted.sum(dim=1))     # [B, K]     (sum over queries -> key-centric)
+    else:
+        cls_attn = attn_tensor[:, :, 0, 1:]      # [B, H, K]
+        cls_grad = attn_grad[:, :, 0, 1:]        # [B, H, K]
+        cam_vec = F.relu((cls_attn * cls_grad).mean(dim=1))  # [B, K]
+
+    expected = h * w
+    if cam_vec.shape[1] != expected:
+        raise ValueError(
+            f"CAM token count mismatch. Got {cam_vec.shape[1]}. "
+            f"Expected {expected}. Grid={h}x{w}. "
+            f"mean_flag={mean_flag}. "
+            f"attn_shape={tuple(attn_tensor.shape)}."
+        )
+
+    cam_map = cam_vec.view(cam_vec.shape[0], h, w)
+    cam_map = minmax_normalize_map(cam_map)
+
+    if not return_diagnostics:
+        return cam_map
+
+    # Diagnostics are computed on detached copies so the gradient graph for
+    # cam_map (returned un-detached) is completely unaffected.
+    with torch.no_grad():
+        cam_det = cam_map.detach()
+        b_size = cam_det.shape[0]
+        flat_cam = cam_det.view(b_size, -1)
+
+        cam_min = flat_cam.min(dim=1)[0].mean()
+        cam_max = flat_cam.max(dim=1)[0].mean()
+        cam_mean = flat_cam.mean()
+        cam_std = flat_cam.std()
+        cam_nonzero_fraction = (flat_cam > 0).float().mean()
+
+        # Gradient stats over the patch sub-matrix used to build the CAM.
+        if mean_flag:
+            grad_patch = attn_grad[:, :, 1:, 1:].detach().abs()
+        else:
+            grad_patch = attn_grad[:, :, 0, 1:].detach().abs()
+
+        attn_grad_abs_mean = grad_patch.mean()
+        attn_grad_abs_max = grad_patch.max()
+        attn_grad_zero_fraction = (grad_patch == 0).float().mean()
+
+    diagnostics = {
+        "cam_min": cam_min,
+        "cam_max": cam_max,
+        "cam_mean": cam_mean,
+        "cam_std": cam_std,
+        "cam_nonzero_fraction": cam_nonzero_fraction,
+        "attn_grad_abs_mean": attn_grad_abs_mean,
+        "attn_grad_abs_max": attn_grad_abs_max,
+        "attn_grad_zero_fraction": attn_grad_zero_fraction,
+    }
+
+    return cam_map, diagnostics
+
+
+def build_cls_patch_map(model, patch_tokens, target):
+    base_model = _unwrap_model(model)
+    h, w = validate_patch_tokens_for_grid(base_model, patch_tokens)
+
+    head_weight = base_model.head.weight.float()
+    selected_weight = head_weight[target]
+    patch_scores = (patch_tokens.float() * selected_weight.unsqueeze(1)).sum(dim=-1)
+    patch_scores = F.softplus(patch_scores)
+
+    patch_map = patch_scores.view(patch_scores.shape[0], h, w)
+    patch_map = minmax_normalize_map(patch_map)
+    return patch_map
+
+
+def build_all_cls_patch_maps(model, patch_tokens):
+    base_model = _unwrap_model(model)
+    h, w = validate_patch_tokens_for_grid(base_model, patch_tokens)
+
+    tokens = patch_tokens.float()
+
+    if bool(getattr(base_model, "use_mean_pooling", False)) and base_model.fc_norm is not None:
+        tokens = base_model.fc_norm(tokens)
+
+    head_weight = base_model.head.weight.float()
+
+    patch_scores = torch.einsum("bnd,cd->bcn", tokens, head_weight)
+    patch_scores = F.softplus(patch_scores)
+
+    patch_maps = patch_scores.view(patch_scores.shape[0], patch_scores.shape[1], h, w)
+
+    b, c, _, _ = patch_maps.shape
+    flat = patch_maps.float().view(b, c, -1)
+    min_v = flat.min(dim=-1, keepdim=True)[0].view(b, c, 1, 1)
+    max_v = flat.max(dim=-1, keepdim=True)[0].view(b, c, 1, 1)
+
+    denom = (max_v - min_v).clamp_min(1e-6)
+    patch_maps = (patch_maps.float() - min_v) / denom
+    return patch_maps
+
+
+def select_dal_patch_maps(patch_maps, logits, hard_targets, dal_mode="all_classes", dal_topk=3):
+    if dal_mode == "all_classes":
+        return patch_maps
+
+    if dal_mode != "topk_non_target":
+        raise ValueError(f"Unsupported dal_mode: {dal_mode}")
+
+    b, c, h, w = patch_maps.shape
+    k = max(2, min(int(dal_topk), c))
+
+    probs = torch.softmax(logits.detach(), dim=1)
+    selected_maps = []
+
+    for idx in range(b):
+        target = int(hard_targets[idx].item())
+        ranked = torch.argsort(probs[idx], descending=True).tolist()
+        chosen = [target]
+        for cls_idx in ranked:
+            if cls_idx != target and cls_idx not in chosen:
+                chosen.append(cls_idx)
+            if len(chosen) >= k:
+                break
+        selected_maps.append(patch_maps[idx, chosen])
+
+    return torch.stack(selected_maps, dim=0)
+
+
+def dal_cosine_loss(patch_maps, eps=1e-6):
+    b, c, _, _ = patch_maps.shape
+    if c < 2:
+        return patch_maps.new_tensor(0.0)
+
+    flat = patch_maps.float().view(b, c, -1)
+    flat = F.normalize(flat, p=2, dim=-1, eps=eps)
+    similarity = torch.bmm(flat, flat.transpose(1, 2))
+
+    upper_mask = torch.triu(
+        torch.ones(c, c, dtype=torch.bool, device=patch_maps.device),
+        diagonal=1,
+    )
+    pairwise_similarity = similarity[:, upper_mask]
+    return pairwise_similarity.abs().mean()
+
+
+def compute_ha_loss(pred, target, loss_type="paper_dice", fp_weight=1.0, eps=1e-6):
+    if loss_type == "paper_dice":
+        return ha_soft_dice_loss(pred, target, eps=eps)
+    if loss_type == "alignment":
+        return ha_alignment_loss(pred, target, fp_weight=fp_weight, eps=eps)
+    raise ValueError(f"Unsupported ha_loss_type: {loss_type}")
+
+
+def compute_ha_metric(pred, target, loss_type="paper_dice", fp_weight=1.0, eps=1e-6):
+    if loss_type == "paper_dice":
+        return 1.0 - ha_soft_dice_loss(pred, target, eps=eps)
+    if loss_type == "alignment":
+        return ha_alignment_score(pred, target, fp_weight=fp_weight, eps=eps)
+    raise ValueError(f"Unsupported ha_loss_type: {loss_type}")
+
+
+def compute_ha_metric_components(pred, target, fp_weight=1.0, eps=1e-6):
+    pred = pred.float()
+    target = target.float()
+
+    intersection = (pred * target).sum(dim=(1, 2))
+    pred_sum = pred.sum(dim=(1, 2))
+    target_sum = target.sum(dim=(1, 2))
+    dice = (2.0 * intersection + eps) / (pred_sum + target_sum + eps)
+
+    inside_mass = (pred * target).sum(dim=(1, 2))
+    outside_mass = (pred * (1.0 - target)).sum(dim=(1, 2))
+    target_area = target.sum(dim=(1, 2))
+    background_area = (1.0 - target).sum(dim=(1, 2))
+
+    inside_mean = inside_mass / (target_area + eps)
+    outside_mean = outside_mass / (background_area + eps)
+    alignment_score = inside_mean - fp_weight * outside_mean
+
+    return {
+        "ha_dice": dice.mean(),
+        "ha_alignment_score": alignment_score.mean(),
+        "ha_inside_mean": inside_mean.mean(),
+        "ha_outside_mean": outside_mean.mean(),
+    }
+
+FEAT_MEL_IDX, FEAT_NV_IDX = 0, 1
+
+def per_sample_dice_loss(pred, target, eps=1e-6):
+    inter = (pred.float() * target.float()).sum(dim=(1, 2))
+    denom = pred.float().sum(dim=(1, 2)) + target.float().sum(dim=(1, 2))
+    return 1.0 - (2.0 * inter + eps) / (denom + eps)
+
+def feature_channel_loss(pred, target, rule, eps=1e-6):
+    """Per sample loss and weight for one channel.
+
+    Non empty target, soft dice. Empty target under rule 'both', push the mean
+    activation to zero. Empty target under rule 'single', no loss.
+    """
+    has_t = target.float().sum(dim=(1, 2)) > 0
+    dice = per_sample_dice_loss(pred, target, eps)
+    supp = pred.float().mean(dim=(1, 2))
+    if rule == "single":
+        return dice, has_t.float()
+    return torch.where(has_t, dice, supp), torch.ones_like(supp)
+
+def compute_feature_loss(cam_mel, cam_nv, feat, has_feat, rule):
+    w = has_feat.float()
+    l_m, w_m = feature_channel_loss(cam_mel, feat[:, FEAT_MEL_IDX], rule)
+    l_n, w_n = feature_channel_loss(cam_nv, feat[:, FEAT_NV_IDX], rule)
+    num = (l_m * w_m * w).sum() + (l_n * w_n * w).sum()
+    den = (w_m * w).sum() + (w_n * w).sum()
+    return num / den.clamp(min=1.0)
+
+@torch.no_grad()
+def compute_channel_diagnostics(cam_mel, cam_nv, lesion, eps=1e-6):
+    """Degeneracy guards. A dead channel is not a differential explanation."""
+    a, b = cam_mel.detach().float(), cam_nv.detach().float()
+    n = a.shape[0]
+    a_max = a.view(n, -1).max(dim=1)[0]
+    b_max = b.view(n, -1).max(dim=1)[0]
+    dead = ((a_max < 0.05) | (b_max < 0.05)).float().mean()
+
+    L = lesion.squeeze(1) > 0.5
+    corr = []
+    for i in range(n):
+        m = L[i]
+        if m.sum() < 8:
+            continue
+        x, y = a[i][m], b[i][m]
+        if x.std() < 1e-6 or y.std() < 1e-6:
+            continue
+        xc, yc = x - x.mean(), y - y.mean()
+        corr.append((xc * yc).mean() / (x.std() * y.std() + eps))
+    r = torch.stack(corr).mean() if corr else a.new_tensor(float("nan"))
+    return {
+        "feat_dead_channel_frac": dead,
+        "feat_class_corr_in_lesion": r,
+        "feat_mel_max": a_max.mean(),
+        "feat_nv_max": b_max.mean(),
+    }
+
+def both_class_cams(model, logits, create_graph):
+    n = logits.shape[0]
+    dev = logits.device
+    mel = build_attention_gradcam_map(
+        model, logits, torch.full((n,), FEAT_MEL_IDX, device=dev, dtype=torch.long),
+        create_graph=create_graph)
+    nv = build_attention_gradcam_map(
+        model, logits, torch.full((n,), FEAT_NV_IDX, device=dev, dtype=torch.long),
+        create_graph=create_graph)
+    return mel, nv
+
+def compute_cam_mask_diagnostics(pred, target, eps=1e-6):
+    """
+    Compute spatial alignment diagnostics between a normalized CAM and a binary mask.
+
+    Args:
+        pred:   [B, H, W] float tensor, CAM values in [0, 1] after minmax normalization.
+        target: [B, H, W] float tensor, binary mask values in {0.0, 1.0}.
+        eps:    numerical stability constant.
+
+    Returns:
+        dict of scalar tensors (detached, safe to log directly to metric_logger or W&B).
+
+    Key metric: inside_minus_area_baseline > 0 means the CAM is more concentrated
+    inside the lesion than a uniform random map would be. This is the primary
+    indicator that HA training is producing a meaningful alignment signal.
+    """
+    pred = pred.detach().float()
+    target = target.detach().float()
+
+    if pred.dim() != 3 or target.dim() != 3:
+        raise ValueError(
+            f"Expected pred and target [B, H, W], got pred={tuple(pred.shape)}, target={tuple(target.shape)}"
+        )
+
+    b, height, width = pred.shape
+    grid_area = float(height * width)
+
+    total_cam_mass = pred.sum(dim=(1, 2))                              # [B]
+    inside_mass = (pred * target).sum(dim=(1, 2))                      # [B]
+    outside_mass = (pred * (1.0 - target)).sum(dim=(1, 2))             # [B]
+    mask_area = target.sum(dim=(1, 2))                                 # [B]
+    background_area = (1.0 - target).sum(dim=(1, 2))                   # [B]
+
+    inside_cam_fraction = inside_mass / (total_cam_mass + eps)         # [B]
+    mask_area_fraction = mask_area / grid_area                         # [B]
+
+    # Positive value means CAM is biased toward the lesion above chance.
+    inside_minus_area_baseline = inside_cam_fraction - mask_area_fraction  # [B]
+
+    inside_density = inside_mass / (mask_area + eps)                   # [B]
+    outside_density = outside_mass / (background_area + eps)           # [B]
+    inside_outside_density_ratio = inside_density / (outside_density + eps)  # [B]
+
+    dice_cam_mask = (2.0 * inside_mass + eps) / (total_cam_mass + mask_area + eps)  # [B]
+
+    empty_mask = (mask_area == 0).float()                              # [B]
+    full_mask = (background_area == 0).float()                         # [B]
+
+    return {
+        "inside_cam_fraction":          inside_cam_fraction.mean(),
+        "mask_area_fraction":           mask_area_fraction.mean(),
+        "inside_minus_area_baseline":   inside_minus_area_baseline.mean(),
+        "inside_density":               inside_density.mean(),
+        "outside_density":              outside_density.mean(),
+        "inside_outside_density_ratio": inside_outside_density_ratio.mean(),
+        "dice_cam_mask":                dice_cam_mask.mean(),
+        "empty_mask_fraction":          empty_mask.mean(),
+        "full_mask_fraction":           full_mask.mean(),
+    }
+
+
+def train_one_epoch_ha(
+    model,
+    criterion,
+    data_loader,
+    optimizer,
+    device,
+    epoch,
+    loss_scaler,
+    max_norm=0,
+    mixup_fn=None,
+    lr_schedule_values=None,
+    wd_schedule_values=None,
+    start_steps=0,
+    num_training_steps_per_epoch=None,
+    update_freq=1,
+    ha_lambda=0.5,
+    ha_start_epoch=0,
+    ha_fp_weight=1.0,
+    ha_loss_type="paper_dice",
+    dal_lambda=0.0,
+    dal_mode="all_classes",
+    dal_topk=3,
+    debug_batches=0,
+    disable_amp=False,
+):
+    model.train(True)
+    metric_logger = utils.MetricLogger(delimiter="  ")
+    metric_logger.add_meter("lr", utils.SmoothedValue(window_size=1, fmt="{value:.6f}"))
+    header = f"Epoch: [{epoch}]"
+    print_freq = 200
+
+    optimizer.zero_grad()
+
+    for data_iter_step, batch in enumerate(metric_logger.log_every(data_loader, print_freq, header)):
+        # samples, image_ids, targets, masks = batch
+        samples, image_ids, targets, masks = batch[0], batch[1], batch[2], batch[3]
+        step = data_iter_step // update_freq
+
+        if num_training_steps_per_epoch is not None and step >= num_training_steps_per_epoch:
+            continue
+
+        it = start_steps + step
+        if (lr_schedule_values is not None or wd_schedule_values is not None) and data_iter_step % update_freq == 0:
+            for param_group in optimizer.param_groups:
+                if lr_schedule_values is not None:
+                    if "lr_scale" in param_group:
+                        param_group["lr"] = lr_schedule_values[it] * param_group["lr_scale"]
+                    else:
+                        param_group["lr"] = lr_schedule_values[it]
+                if wd_schedule_values is not None and param_group["weight_decay"] > 0:
+                    param_group["weight_decay"] = wd_schedule_values[it]
+
+        samples = samples.to(device, non_blocking=True)
+        # PATCH 1A: cast to long to guarantee dtype compatibility with gather, one_hot, CE.
+        hard_targets = targets.to(device, non_blocking=True).long()
+        masks = masks.to(device, non_blocking=True)
+
+        targets_for_loss = hard_targets
+        if mixup_fn is not None:
+            samples, targets_for_loss = mixup_fn(samples, hard_targets)
+
+        with torch.cuda.amp.autocast(enabled=torch.cuda.is_available() and not disable_amp):
+            ha_active = epoch >= ha_start_epoch and ha_lambda > 0.0
+            dal_active = epoch >= ha_start_epoch and dal_lambda > 0.0
+            explanation_loss_active = ha_active or dal_active
+
+            if explanation_loss_active:
+                outputs = model(samples, return_patch_tokens=True, store_attn=True, attn_layer=-1)
+            else:
+                outputs = model(samples)
+
+            logits, patch_tokens = unpack_model_outputs(outputs)
+            cls_loss = criterion(logits, targets_for_loss)
+
+            if epoch == 0 and data_iter_step == 0:
+                print("logits shape:", logits.shape)
+                print("patch_tokens is None:", patch_tokens is None)
+                if patch_tokens is not None:
+                    print("patch_tokens shape:", patch_tokens.shape)
+
+            if explanation_loss_active and patch_tokens is None:
+                raise ValueError(
+                    "Explanation loss is active but the model did not return patch_tokens. "
+                    "Check the model forward path for return_patch_tokens=True."
+                )
+
+            if ha_active:
+                patch_map, cam_diag = build_attention_gradcam_map(
+                    model, logits, hard_targets,
+                    create_graph=True,
+                    return_diagnostics=True,
+                )
+                resized_masks = F.interpolate(
+                    masks.float(),
+                    size=patch_map.shape[-2:],
+                    mode="nearest",
+                ).squeeze(1)
+                resized_masks = (resized_masks > 0.5).float()
+                ha_loss = compute_ha_loss(
+                    patch_map,
+                    resized_masks,
+                    loss_type=ha_loss_type,
+                    fp_weight=ha_fp_weight,
+                )
+                mask_diag = compute_cam_mask_diagnostics(patch_map, resized_masks)
+            else:
+                patch_map = None
+                resized_masks = None
+                ha_loss = cls_loss.new_tensor(0.0)
+                cam_diag = None
+                mask_diag = None
+
+            if dal_active:
+                dal_maps = build_all_cls_patch_maps(model, patch_tokens)
+                dal_maps = select_dal_patch_maps(
+                    dal_maps,
+                    logits=logits,
+                    hard_targets=hard_targets,
+                    dal_mode=dal_mode,
+                    dal_topk=dal_topk,
+                )
+                dal_loss = dal_cosine_loss(dal_maps)
+            else:
+                dal_loss = cls_loss.new_tensor(0.0)
+
+            effective_ha_lambda = ha_lambda if ha_active else 0.0
+            effective_dal_lambda = dal_lambda if dal_active else 0.0
+            loss = cls_loss + effective_ha_lambda * ha_loss + effective_dal_lambda * dal_loss
+
+        if epoch == 0 and data_iter_step < debug_batches:
+            logits_det = logits.detach().float().cpu()
+            targets_det = hard_targets.detach().cpu()
+            patch_map_det = patch_map.detach().float().cpu() if patch_map is not None else None
+            mask_det = resized_masks.detach().float().cpu() if resized_masks is not None else None
+
+            print("=" * 80)
+            print(f"DEBUG BATCH epoch={epoch} iter={data_iter_step}")
+            print(f"targets dtype={hard_targets.dtype} shape={tuple(hard_targets.shape)}")
+            print(f"targets unique={torch.unique(targets_det).tolist()}")
+            print(f"targets first16={targets_det[:16].tolist()}")
+            print(f"logits shape={tuple(logits.shape)}")
+            print(f"outputs python type={type(outputs)}")
+            print(f"patch_tokens returned={patch_tokens is not None}")
+            print(f"logits mean={logits_det.mean().item():.6f} std={logits_det.std().item():.6f}")
+            print(f"logits first sample={logits_det[0].tolist()}")
+            print(f"cls_loss={float(cls_loss.detach().cpu().item()):.6f}")
+            print(f"ha_loss={float(ha_loss.detach().cpu().item()):.6f}")
+            print(f"ha_start_epoch={ha_start_epoch} ha_active={ha_active} effective_ha_lambda={effective_ha_lambda:.6f}")
+            print(f"dal_loss={float(dal_loss.detach().cpu().item()):.6f}")
+            print(f"dal_lambda={dal_lambda:.6f} dal_active={dal_active} effective_dal_lambda={effective_dal_lambda:.6f} dal_mode={dal_mode} dal_topk={dal_topk}")
+            print(f"ha_fp_weight={ha_fp_weight:.6f}")
+            print(f"total_loss={float(loss.detach().cpu().item()):.6f}")
+            if patch_map_det is not None:
+                print(
+                    f"patch_map stats min={patch_map_det.min().item():.6f} "
+                    f"max={patch_map_det.max().item():.6f} mean={patch_map_det.mean().item():.6f}"
+                )
+                print(
+                    f"mask stats min={mask_det.min().item():.6f} "
+                    f"max={mask_det.max().item():.6f} mean={mask_det.mean().item():.6f}"
+                )
+            else:
+                print("patch_map stats skipped because ha_lambda == 0")
+                print("mask stats skipped because ha_lambda == 0")
+            print("=" * 80)
+
+        loss_value = loss.item()
+        if not math.isfinite(loss_value):
+            print(f"Loss is {loss_value}, stopping training")
+            raise RuntimeError("Non-finite loss")
+
+        loss = loss / update_freq
+
+        if disable_amp:
+            loss.backward()
+            if (data_iter_step + 1) % update_freq == 0:
+                if max_norm and max_norm > 0:
+                    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm)
+                optimizer.step()
+                optimizer.zero_grad()
+            grad_norm = None
+        else:
+            is_second_order = hasattr(optimizer, "is_second_order") and optimizer.is_second_order
+            grad_norm = loss_scaler(
+                loss,
+                optimizer,
+                clip_grad=max_norm,
+                parameters=model.parameters(),
+                create_graph=is_second_order,
+                update_grad=(data_iter_step + 1) % update_freq == 0,
+            )
+
+        if (data_iter_step + 1) % update_freq == 0 and not disable_amp:
+            optimizer.zero_grad()
+
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
+
+        if mixup_fn is None:
+            class_acc = (logits.max(-1)[-1] == hard_targets).float().mean()
+        else:
+            class_acc = None
+
+        metric_logger.update(loss=loss_value)
+        metric_logger.update(cls_loss=float(cls_loss.detach()))
+        metric_logger.update(ha_loss=float(ha_loss.detach()))
+        metric_logger.update(weighted_ha_loss=float((effective_ha_lambda * ha_loss).detach()))
+        metric_logger.update(dal_loss=float(dal_loss.detach()))
+        metric_logger.update(weighted_dal_loss=float((effective_dal_lambda * dal_loss).detach()))
+        metric_logger.update(ha_active=float(ha_active))
+        metric_logger.update(dal_active=float(dal_active))
+        metric_logger.update(effective_ha_lambda=float(effective_ha_lambda))
+        metric_logger.update(effective_dal_lambda=float(effective_dal_lambda))
+
+        if class_acc is not None:
+            metric_logger.update(class_acc=class_acc)
+
+        # PATCH 6: log CAM and mask alignment diagnostics when HA is active.
+        if ha_active and cam_diag is not None and mask_diag is not None:
+            for k, v in cam_diag.items():
+                metric_logger.update(**{k: float(v.item())})
+            for k, v in mask_diag.items():
+                metric_logger.update(**{k: float(v.item())})
+
+        max_lr = 0.0
+        for group in optimizer.param_groups:
+            max_lr = max(max_lr, group["lr"])
+        metric_logger.update(lr=max_lr)
+
+    metric_logger.synchronize_between_processes()
+    print("Averaged stats:", metric_logger)
+    return {k: meter.global_avg for k, meter in metric_logger.meters.items()}
+
+def train_one_epoch_a2(
+    model, criterion, ce_loader, feat_loader, optimizer, device, epoch,
+    max_norm=0, lr_schedule_values=None, wd_schedule_values=None,
+    start_steps=0, num_training_steps_per_epoch=None,
+    feat_lambda=1.0, feat_rule="both", feat_start_epoch=0, debug_batches=0,
+    ha_lambda=0.0, ha_loss_type="paper_dice", ha_fp_weight=1.0,
+):
+    """L = CE + ha_lambda * HA1(lesion mask, target class map)
+             + feat_lambda * HA2(concept masks, both class maps).
+    HA1 runs on the CE batch, HA2 on the feature batch, one backward pass."""
+    model.train(True)
+    logger = utils.MetricLogger(delimiter="  ")
+    logger.add_meter("lr", utils.SmoothedValue(window_size=1, fmt="{value:.6f}"))
+    optimizer.zero_grad()
+    f_iter = iter(feat_loader) if feat_loader is not None else None
+    base = _unwrap_model(model)
+
+    for it_step, batch in enumerate(logger.log_every(ce_loader, 200, f"Epoch: [{epoch}]")):
+        if num_training_steps_per_epoch is not None and it_step >= num_training_steps_per_epoch:
+            continue
+        it = start_steps + it_step
+        for g in optimizer.param_groups:
+            if lr_schedule_values is not None:
+                g["lr"] = lr_schedule_values[it] * g.get("lr_scale", 1.0)
+            if wd_schedule_values is not None and g["weight_decay"] > 0:
+                g["weight_decay"] = wd_schedule_values[it]
+
+        x, _, y, les, _, _ = batch
+        x = x.to(device, non_blocking=True)
+        y = y.to(device, non_blocking=True).long()
+
+        # ---- CE, plus HA1 on the same batch --------------------------------
+        ha_on = epoch >= feat_start_epoch and ha_lambda > 0.0
+        if ha_on:
+            base.clear_xai_state()
+            logits, _ = unpack_model_outputs(
+                model(x, return_patch_tokens=True, store_attn=True, attn_layer=-1))
+            cls_loss = criterion(logits, y)
+            pm = build_attention_gradcam_map(model, logits, y, create_graph=True)
+            lm = F.interpolate(les.to(device, non_blocking=True).float(),
+                               size=pm.shape[-2:], mode="nearest").squeeze(1)
+            lm = (lm > 0.5).float()
+            ha_loss = compute_ha_loss(pm, lm, loss_type=ha_loss_type,
+                                      fp_weight=ha_fp_weight)
+            ha_diag = compute_cam_mask_diagnostics(pm, lm)
+            base.clear_xai_state()
+        else:
+            logits, _ = unpack_model_outputs(model(x))
+            cls_loss = criterion(logits, y)
+            ha_loss = cls_loss.new_tensor(0.0)
+            ha_diag = None
+
+        # ---- HA2 on the feature batch, unchanged ---------------------------
+        active = epoch >= feat_start_epoch and feat_lambda > 0.0
+        if active:
+            try:
+                fb = next(f_iter)
+            except StopIteration:
+                f_iter = iter(feat_loader)
+                fb = next(f_iter)
+            fx, _, fy, fles, feat, hf = fb
+            fx = fx.to(device, non_blocking=True)
+            feat = feat.to(device, non_blocking=True)
+            hf = hf.to(device, non_blocking=True)
+            fles = fles.to(device, non_blocking=True)
+            base.clear_xai_state()
+            f_logits, _ = unpack_model_outputs(
+                model(fx, return_patch_tokens=True, store_attn=True, attn_layer=-1))
+            cam_mel, cam_nv = both_class_cams(model, f_logits, create_graph=True)
+            g = (F.interpolate(feat.float(), size=cam_mel.shape[-2:], mode="nearest") > 0.5).float()
+            g[:, FEAT_NV_IDX] = g[:, FEAT_NV_IDX] * (1.0 - g[:, FEAT_MEL_IDX])
+            gl = F.interpolate(fles.float(), size=cam_mel.shape[-2:], mode="nearest")
+            feat_loss = compute_feature_loss(cam_mel, cam_nv, g, hf, feat_rule)
+            diag = compute_channel_diagnostics(cam_mel, cam_nv, gl)
+            base.clear_xai_state()
+        else:
+            feat_loss = cls_loss.new_tensor(0.0)
+            diag = None
+
+        ha_eff = ha_lambda if ha_on else 0.0
+        eff = feat_lambda if active else 0.0
+        loss = cls_loss + ha_eff * ha_loss + eff * feat_loss
+        if not math.isfinite(loss.item()):
+            raise RuntimeError(f"Non finite loss {loss.item()}")
+        loss.backward()
+        if max_norm and max_norm > 0:
+            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm)
+        optimizer.step()
+        optimizer.zero_grad()
+
+        if epoch == 0 and it_step < debug_batches:
+            print(f"DEBUG f2 it={it_step} ce={cls_loss.item():.4f} "
+                  f"ha1={ha_loss.item():.4f} ha2={feat_loss.item():.4f} "
+                  f"ha_eff={ha_eff} feat_eff={eff}")
+
+        logger.update(loss=loss.item())
+        logger.update(cls_loss=float(cls_loss.detach()))
+        logger.update(ha_loss=float(ha_loss.detach()))
+        logger.update(weighted_ha_loss=float((ha_eff * ha_loss).detach()))
+        logger.update(feat_loss=float(feat_loss.detach()))
+        logger.update(weighted_feat_loss=float((eff * feat_loss).detach()))
+        logger.update(feat_active=float(active))
+        logger.update(ha_active=float(ha_on))
+        if ha_diag is not None:
+            for k, v in ha_diag.items():
+                logger.update(**{k: float(v.item())})
+        if diag is not None:
+            for k, v in diag.items():
+                if torch.isfinite(v):
+                    logger.update(**{k: float(v.item())})
+        logger.update(lr=max(g["lr"] for g in optimizer.param_groups))
+
+    logger.synchronize_between_processes()
+    print("Averaged stats:", logger)
+    return {k: m.global_avg for k, m in logger.meters.items()}
+
+
+def evaluate_features(loader, model, device, feat_rule="both"):
+    """Held out feature loss and degeneracy. Logging only."""
+    model.eval()
+    acc, n = {}, 0
+    for x, _, _, les, feat, hf in loader:
+        x = x.to(device); feat = feat.to(device)
+        hf = hf.to(device); les = les.to(device)
+        with torch.enable_grad():
+            base = _unwrap_model(model)
+            base.clear_xai_state()
+            out = model(x, return_patch_tokens=True, store_attn=True, attn_layer=-1)
+            logits, _ = unpack_model_outputs(out)
+            cam_mel, cam_nv = both_class_cams(model, logits, create_graph=False)
+            cam_mel, cam_nv = cam_mel.detach(), cam_nv.detach()
+            base.clear_xai_state()
+        g = (F.interpolate(feat.float(), size=cam_mel.shape[-2:], mode="nearest") > 0.5).float()
+        g[:, FEAT_NV_IDX] = g[:, FEAT_NV_IDX] * (1.0 - g[:, FEAT_MEL_IDX])
+        gl = F.interpolate(les.float(), size=cam_mel.shape[-2:], mode="nearest")
+        b = x.shape[0]
+        vals = {"feat_loss": compute_feature_loss(cam_mel, cam_nv, g, hf, feat_rule)}
+        vals.update(compute_channel_diagnostics(cam_mel, cam_nv, gl))
+        for k, v in vals.items():
+            if torch.isfinite(v):
+                acc[k] = acc.get(k, 0.0) + float(v.item()) * b
+        n += b
+    return {k: v / max(n, 1) for k, v in acc.items()}
+
+
+def evaluate_ha(data_loader, model, device, num_class, ha_fp_weight=1.0, ha_loss_type="paper_dice"):
+    criterion = torch.nn.CrossEntropyLoss()
+    model.eval()
+
+    prediction_list = []
+    prediction_decode_list = []
+    true_label_decode_list = []
+    true_label_onehot_list = []
+
+    total_loss = 0.0
+    ha_metric_list = []
+    ha_dice_list = []
+    ha_alignment_score_list = []
+    ha_inside_mean_list = []
+    ha_outside_mean_list = []
+    count = 0
+
+    # PATCH 7: diagnostic accumulators matching training metric names for W&B overlay.
+    diag_keys = [
+        "cam_min", "cam_max", "cam_mean", "cam_std", "cam_nonzero_fraction",
+        "attn_grad_abs_mean", "attn_grad_abs_max", "attn_grad_zero_fraction",
+        "inside_cam_fraction", "mask_area_fraction", "inside_minus_area_baseline",
+        "inside_density", "outside_density", "inside_outside_density_ratio",
+        "dice_cam_mask", "empty_mask_fraction", "full_mask_fraction",
+    ]
+    diag_accum = {k: [] for k in diag_keys}
+
+    for batch in data_loader:
+        # images, image_ids, targets, masks = batch
+        images, image_ids, targets, masks = batch[0], batch[1], batch[2], batch[3]
+        images = images.to(device, non_blocking=True)
+        # PATCH 1B: cast to long for gather, one_hot, CE, and sklearn compatibility.
+        targets = targets.to(device, non_blocking=True).long()
+
+        with torch.enable_grad():
+            outputs = model(images, return_patch_tokens=True, store_attn=True, attn_layer=-1)
+            logits, patch_tokens = unpack_model_outputs(outputs)
+
+            if patch_tokens is None:
+                raise ValueError(
+                    "Evaluation expected patch_tokens but the model did not return them."
+                )
+
+            loss = criterion(logits, targets)
+            loss_value = float(loss.detach().cpu().item())
+
+            patch_map, cam_diag = build_attention_gradcam_map(
+                model,
+                logits,
+                targets,
+                create_graph=False,
+                return_diagnostics=True,
+            )
+
+            patch_map = patch_map.detach()
+            logits = logits.detach()
+
+            del outputs
+            del patch_tokens
+            del loss
+
+            _unwrap_model(model).clear_xai_state()
+
+        resized_masks = F.interpolate(
+            masks.float().to(device, non_blocking=True),
+            size=patch_map.shape[-2:],
+            mode="nearest",
+        ).squeeze(1)
+        resized_masks = (resized_masks > 0.5).float()
+
+        batch_ha_metric = compute_ha_metric(
+            patch_map,
+            resized_masks,
+            loss_type=ha_loss_type,
+            fp_weight=ha_fp_weight,
+        )
+        ha_components = compute_ha_metric_components(
+            patch_map,
+            resized_masks,
+            fp_weight=ha_fp_weight,
+        )
+        mask_diag = compute_cam_mask_diagnostics(patch_map, resized_masks)
+
+        for k in cam_diag:
+            diag_accum[k].append(float(cam_diag[k].item()))
+        for k in mask_diag:
+            diag_accum[k].append(float(mask_diag[k].item()))
+
+        probs = torch.softmax(logits, dim=1)
+        preds = probs.argmax(dim=1)
+        true_onehot = F.one_hot(targets.to(torch.int64), num_classes=num_class)
+
+        total_loss += loss_value * images.shape[0]
+        count += images.shape[0]
+
+        prediction_list.extend(probs.detach().cpu().numpy())
+        prediction_decode_list.extend(preds.detach().cpu().numpy())
+        true_label_decode_list.extend(targets.detach().cpu().numpy())
+        true_label_onehot_list.extend(true_onehot.detach().cpu().numpy())
+
+        ha_metric_list.append(float(batch_ha_metric.detach().cpu().item()))
+        ha_dice_list.append(float(ha_components["ha_dice"].detach().cpu().item()))
+        ha_alignment_score_list.append(float(ha_components["ha_alignment_score"].detach().cpu().item()))
+        ha_inside_mean_list.append(float(ha_components["ha_inside_mean"].detach().cpu().item()))
+        ha_outside_mean_list.append(float(ha_components["ha_outside_mean"].detach().cpu().item()))
+
+        del patch_map
+        del resized_masks
+        del probs
+        del preds
+        del true_onehot
+
+    prediction_array = np.array(prediction_list)
+    prediction_decode_array = np.array(prediction_decode_list)
+    true_label_decode_array = np.array(true_label_decode_list)
+    true_label_onehot_array = np.array(true_label_onehot_list)
+
+    bacc = balanced_accuracy_score(true_label_decode_array, prediction_decode_array)
+    acc = accuracy_score(true_label_decode_array, prediction_decode_array)
+    f1 = f1_score(
+        true_label_decode_array,
+        prediction_decode_array,
+        average="weighted",
+        zero_division=0,
+    )
+    recall_macro = recall_score(
+        true_label_decode_array,
+        prediction_decode_array,
+        average="macro",
+        zero_division=0,
+    )
+    recall_weighted = recall_score(
+        true_label_decode_array,
+        prediction_decode_array,
+        average="weighted",
+        zero_division=0,
+    )
+
+    try:
+        if num_class == 2:
+            auc_roc = roc_auc_score(true_label_decode_array, prediction_array[:, 1])
+        else:
+            auc_roc = roc_auc_score(
+                true_label_onehot_array,
+                prediction_array,
+                multi_class="ovr",
+                average="macro",
+            )
+    except Exception:
+        auc_roc = float("nan")
+
+    metrics = {
+        "loss": total_loss / max(count, 1),
+        "balanced_accuracy": bacc,
+        "accuracy": acc,
+        "auc_roc": auc_roc,
+        "weighted_f1": f1,
+        "recall_macro": recall_macro,
+        "recall_weighted": recall_weighted,
+        "ha_metric": float(np.mean(ha_metric_list)) if len(ha_metric_list) > 0 else float("nan"),
+        "ha_dice": float(np.mean(ha_dice_list)) if len(ha_dice_list) > 0 else float("nan"),
+        "ha_alignment_score": float(np.mean(ha_alignment_score_list)) if len(ha_alignment_score_list) > 0 else float("nan"),
+        "ha_inside_mean": float(np.mean(ha_inside_mean_list)) if len(ha_inside_mean_list) > 0 else float("nan"),
+        "ha_outside_mean": float(np.mean(ha_outside_mean_list)) if len(ha_outside_mean_list) > 0 else float("nan"),
+    }
+
+    # PATCH 7: merge spatial diagnostics into returned metrics dict.
+    for k, v_list in diag_accum.items():
+        metrics[k] = float(np.mean(v_list)) if len(v_list) > 0 else float("nan")
+
+    return metrics
+
