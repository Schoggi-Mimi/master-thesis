+@torch.no_grad()
+def evaluate_classifier_safe(data_loader, model, device, num_class):
+    criterion = torch.nn.CrossEntropyLoss()
+    model.eval()
+
+    prediction_list = []
+    prediction_decode_list = []
+    true_label_decode_list = []
+    true_label_onehot_list = []
+
+    total_loss = 0.0
+    count = 0
+
+    for batch in data_loader:
+        images = batch[0]
+        targets = batch[2]
+
+        images = images.to(device, non_blocking=True)
+        targets = targets.to(device, non_blocking=True)
+
+        with torch.cuda.amp.autocast(enabled=False):
+            outputs = model(images)
+            logits, _ = unpack_model_outputs(outputs)
+            loss = criterion(logits, targets)
+
+        probs = torch.softmax(logits, dim=1)
+        preds = probs.argmax(dim=1)
+        true_onehot = F.one_hot(targets.to(torch.int64), num_classes=num_class)
+
+        total_loss += loss.item() * images.shape[0]
+        count += images.shape[0]
+
+        prediction_list.extend(probs.detach().cpu().numpy())
+        prediction_decode_list.extend(preds.detach().cpu().numpy())
+        true_label_decode_list.extend(targets.detach().cpu().numpy())
+        true_label_onehot_list.extend(true_onehot.detach().cpu().numpy())
+
+    prediction_array = np.array(prediction_list)
+    prediction_decode_array = np.array(prediction_decode_list)
+    true_label_decode_array = np.array(true_label_decode_list)
+    true_label_onehot_array = np.array(true_label_onehot_list)
+
+    bacc = balanced_accuracy_score(true_label_decode_array, prediction_decode_array)
+    acc = accuracy_score(true_label_decode_array, prediction_decode_array)
+    f1 = f1_score(
+        true_label_decode_array,
+        prediction_decode_array,
+        average="weighted",
+        zero_division=0,
+    )
+    recall_macro = recall_score(
+        true_label_decode_array,
+        prediction_decode_array,
+        average="macro",
+        zero_division=0,
+    )
+    recall_weighted = recall_score(
+        true_label_decode_array,
+        prediction_decode_array,
+        average="weighted",
+        zero_division=0,
+    )
+
+    try:
+        if num_class == 2:
+            auc_roc = roc_auc_score(true_label_decode_array, prediction_array[:, 1])
+        else:
+            auc_roc = roc_auc_score(
+                true_label_onehot_array,
+                prediction_array,
+                multi_class="ovr",
+                average="macro",
+            )
+    except Exception:
+        auc_roc = float("nan")
+
+    return {
+        "loss": total_loss / max(count, 1),
+        "balanced_accuracy": bacc,
+        "accuracy": acc,
+        "auc_roc": auc_roc,
+        "weighted_f1": f1,
+        "recall_macro": recall_macro,
+        "recall_weighted": recall_weighted,
+    }
+
+
+def main(args):
