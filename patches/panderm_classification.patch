+        args.weight_decay_end,
+        args.epochs,
+        num_training_steps_per_epoch,
+    )
+
+    if args.resume:
+        checkpoint = torch.load(args.resume, map_location="cpu")
+        model_without_ddp.load_state_dict(checkpoint["model"], strict=False)
+        if "optimizer" in checkpoint and "epoch" in checkpoint:
+            optimizer.load_state_dict(checkpoint["optimizer"])
+            args.start_epoch = checkpoint["epoch"] + 1
+            if "scaler" in checkpoint:
+                loss_scaler.load_state_dict(checkpoint["scaler"])
+        print(f"Resume from {args.resume}")
+
+    output_dir = Path(args.output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    print(
+        f"Setup: train={len(ds_train)} val={len(ds_val)} test={len(ds_test)} | "
+        f"bg_strength={args.bg_strength} | sampler={args.weights} | "
+        f"class_weights={args.class_weights} | smoothing={args.smoothing} | "
+        f"disable_softmask={args.disable_softmask} | freeze_backbone={args.freeze_backbone} | "
+        f"disable_amp={args.disable_amp}"
+    )
+
+    if args.eval:
+        test_stats = evaluate_softmask(
+            data_loader_test, model, device, args.output_dir, epoch=-1, mode="test", num_class=args.nb_classes
+        )
+        # print(test_stats)  # final sklearn metrics are already printed above
+        return
+
+    print(f"Start training for {args.epochs} epochs")
+    start_time = time.time()
+    max_accuracy = 0.0
+    max_recall = 0.0
+
+    for epoch in range(args.start_epoch, args.epochs):
+        train_stats = train_one_epoch_softmask(
+            model=model,
+            criterion=criterion,
+            data_loader=data_loader_train,
+            optimizer=optimizer,
+            device=device,
+            epoch=epoch,
+            loss_scaler=loss_scaler,
+            max_norm=args.clip_grad if args.clip_grad is not None else 0,
+            model_ema=None,
+            mixup_fn=mixup_fn,
+            log_writer=None,
+            start_steps=epoch * num_training_steps_per_epoch,
+            lr_schedule_values=lr_schedule_values,
+            wd_schedule_values=wd_schedule_values,
+            num_training_steps_per_epoch=num_training_steps_per_epoch,
+            update_freq=args.update_freq,
+            disable_amp=args.disable_amp,
+        )
+
+        val_stats = evaluate_softmask(
+            data_loader_val, model, device, args.output_dir, epoch=epoch, mode="val", num_class=args.nb_classes
+        )
+
+        if args.monitor == "acc":
+            current_metric = val_stats["Val Acc"]
+        else:
+            current_metric = val_stats["Val Recall_macro"]
+
+        if current_metric > (max_accuracy if args.monitor == "acc" else max_recall):
+            checkpoint_path = output_dir / "checkpoint-best.pth"
+            to_save = {
+                "model": model_without_ddp.state_dict(),
+                "optimizer": optimizer.state_dict(),
+                "epoch": epoch,
+                "scaler": loss_scaler.state_dict(),
+                "args": args,
+            }
+            torch.save(to_save, checkpoint_path)
+            print(f"Saved best checkpoint to {checkpoint_path}")
+            if args.monitor == "acc":
+                max_accuracy = current_metric
+            else:
+                max_recall = current_metric
+
+        if args.save_ckpt and ((epoch + 1) % args.save_ckpt_freq == 0 or (epoch + 1) == args.epochs):
+            utils.save_model(
+                args=args,
+                model=model,
+                model_without_ddp=model_without_ddp,
+                optimizer=optimizer,
+                loss_scaler=loss_scaler,
+                epoch=epoch,
+                model_ema=None,
+            )
+
+        log_stats = {
+            **{f"train_{k}": v for k, v in train_stats.items()},
+            **{f"val_{k}": v for k, v in val_stats.items()},
+            "epoch": epoch,
+            "n_parameters": n_parameters,
+        }
+
+        with (output_dir / "log.txt").open("a") as f:
+            f.write(json.dumps(log_stats) + "\n")
+
+        print(f"Max val mean recall so far: {max_recall:.4f}")
+
+    print("Starting test without tta")
+    best_ckpt_path = output_dir / "checkpoint-best.pth"
+    if best_ckpt_path.exists():
+        checkpoint = torch.load(best_ckpt_path, map_location="cpu")
+        state_dict = checkpoint["model"] if "model" in checkpoint else checkpoint
+        model_without_ddp.load_state_dict(state_dict, strict=False)
+        print(f"Loaded best checkpoint from {best_ckpt_path}")
+
+    test_stats = evaluate_softmask(
