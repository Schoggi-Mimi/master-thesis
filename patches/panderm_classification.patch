+from pathlib import Path
+from torchvision import transforms
+from torchvision.transforms import functional as TF
+from torchvision.transforms import InterpolationMode
+
+class PairedDermTransform:
+    def __init__(self, input_size=224, train=True, mean=None, std=None):
+        self.input_size = input_size
+        self.train = train
+        self.mean = mean or [0.485, 0.456, 0.406]
+        self.std = std or [0.228, 0.224, 0.225]
+
+    def __call__(self, image, mask):
+        # Keep lesion geometry stable.
+        image = TF.resize(image, (self.input_size, self.input_size), interpolation=InterpolationMode.BILINEAR)
+        mask = TF.resize(mask, (self.input_size, self.input_size), interpolation=InterpolationMode.NEAREST)
+
+        if self.train:
+            if torch.rand(1).item() < 0.5:
+                image = TF.hflip(image)
+                mask = TF.hflip(mask)
+
+            angle = float(torch.empty(1).uniform_(-10.0, 10.0).item())
+            image = TF.rotate(
+                image,
+                angle,
+                interpolation=InterpolationMode.BILINEAR,
+                fill=0,
+            )
+            mask = TF.rotate(
+                mask,
+                angle,
+                interpolation=InterpolationMode.NEAREST,
+                fill=0,
+            )
+
+            if torch.rand(1).item() < 0.8:
+                brightness = float(torch.empty(1).uniform_(0.9, 1.1).item())
+                contrast = float(torch.empty(1).uniform_(0.9, 1.1).item())
+                saturation = float(torch.empty(1).uniform_(0.9, 1.1).item())
+                hue = float(torch.empty(1).uniform_(-0.05, 0.05).item())
+                image = TF.adjust_brightness(image, brightness)
+                image = TF.adjust_contrast(image, contrast)
+                image = TF.adjust_saturation(image, saturation)
+                image = TF.adjust_hue(image, hue)
+
+        image = TF.to_tensor(image)
+        image = TF.normalize(image, mean=self.mean, std=self.std)
+
+        mask = TF.to_tensor(mask)
+        mask = (mask > 0.5).float()
+        if mask.shape[0] > 1:
+            mask = mask[:1]
+
+        return image, mask
+
