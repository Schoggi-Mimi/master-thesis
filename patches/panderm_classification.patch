+def _load_segmentation_backbone_checkpoint(model, seg_ckpt_path: str):
+    # print("DEBUG loader file:", __file__)
+    seg_ckpt_path = str(seg_ckpt_path)
+    print(f"Load segmentation ckpt from {seg_ckpt_path}")
+    checkpoint = torch.load(seg_ckpt_path, map_location='cpu')
+
+    candidate_dicts = []
+
+    if isinstance(checkpoint, dict):
+        candidate_dicts.append(("checkpoint", checkpoint))
+        for key in ["state_dict", "model", "model_state_dict", "net", "module"]:
+            value = checkpoint.get(key)
+            if isinstance(value, dict):
+                candidate_dicts.append((key, value))
+
+    def extract_backbone_tensors(state_dict):
+        extracted = {}
+        prefixes = [
+            "model.model.segmentor.backbone.",
+            "model.segmentor.backbone.",
+            "segmentor.backbone.",
+            "model.model.segmenter.backbone.",
+            "model.segmenter.backbone.",
+            "segmenter.backbone.",
+            "model.model.backbone.",
+            "model.backbone.",
+            "backbone.",
+        ]
+
+        for key, value in state_dict.items():
+            for prefix in prefixes:
+                if key.startswith(prefix):
+                    new_key = key[len(prefix):]
+                    extracted[new_key] = value
+                    break
+
+        if extracted:
+            return extracted
+
+        plain_backbone_keys = [
+            "cls_token",
+            "pos_embed",
+            "patch_embed.proj.weight",
+            "patch_embed.proj.bias",
+        ]
+        if any(k in state_dict for k in plain_backbone_keys):
+            return dict(state_dict)
+
+        stripped_once = {}
+        for key, value in state_dict.items():
+            if key.startswith("model."):
+                stripped_once[key[len("model."):]] = value
+            else:
+                stripped_once[key] = value
+
+        if stripped_once != state_dict:
+            for key, value in stripped_once.items():
+                for prefix in prefixes:
+                    if key.startswith(prefix):
+                        new_key = key[len(prefix):]
+                        extracted[new_key] = value
+                        break
+            if extracted:
+                return extracted
+
+            if any(k in stripped_once for k in plain_backbone_keys):
+                return dict(stripped_once)
+
+        return {}
+
+    extracted = {}
+    chosen_source = None
+    inspected_keys = []
+
+    for source_name, state_dict in candidate_dicts:
+        if not isinstance(state_dict, dict):
+            continue
+        keys = list(state_dict.keys())
+        inspected_keys.extend([f"{source_name}:{k}" for k in keys[:20]])
+        extracted = extract_backbone_tensors(state_dict)
+        if extracted:
+            chosen_source = source_name
+            break
+
+    print("Chosen source candidates:", [name for name, _ in candidate_dicts])
+    print("Num extracted backbone tensors:", len(extracted))
+    # if extracted:
+    #     print("First extracted keys:", list(extracted.keys())[:10])
+
+    if not extracted:
+        print("Could not find backbone weights. Here are example checkpoint keys:")
+        for key in inspected_keys[:40]:
+            print("  ", key)
+        raise ValueError(
+            "Could not find backbone weights in segmentation checkpoint. "
+            "See printed example keys above and extend the prefix mapping if needed."
+        )
+
+    incompatible = model.load_state_dict(extracted, strict=False)
+    print(f"Loaded {len(extracted)} backbone tensors from segmentation checkpoint source '{chosen_source}'")
+    print(f"Missing keys: {len(incompatible.missing_keys)}")
+    print(f"Unexpected keys: {len(incompatible.unexpected_keys)}")
+
+    # if incompatible.missing_keys:
+    #     print('First missing keys:', incompatible.missing_keys[:20])
+    # if incompatible.unexpected_keys:
+    #     print('First unexpected keys:', incompatible.unexpected_keys[:20])
+
+    return incompatible
+
