+def train_one_epoch_multitask(
+    model,
+    criterion,
+    data_loader,
+    optimizer,
+    device,
+    epoch,
+    loss_scaler,
+    max_norm=0,
+    mixup_fn=None,
+    lr_schedule_values=None,
+    wd_schedule_values=None,
+    start_steps=0,
+    num_training_steps_per_epoch=None,
+    update_freq=1,
+    seg_lambda=1.0,
+    seg_loss_type="bce_dice",
+    use_ha_loss=False,
+    ha_lambda=0.0,
+    ha_fp_weight=1.0,
+    ha_loss_type="paper_dice",
+    debug_batches=0,
+    disable_amp=False,
+    save_debug_seg_vis=False,
+    output_dir="",
+):
+    model.train(True)
+    metric_logger = utils.MetricLogger(delimiter="  ")
+    metric_logger.add_meter("lr", utils.SmoothedValue(window_size=1, fmt="{value:.6f}"))
+    header = f"Epoch: [{epoch}]"
+    print_freq = 200
+    optimizer.zero_grad()
+
+    for data_iter_step, batch in enumerate(metric_logger.log_every(data_loader, print_freq, header)):
+        samples, image_ids, targets, masks = batch
+        step = data_iter_step // update_freq
+        if num_training_steps_per_epoch is not None and step >= num_training_steps_per_epoch:
+            continue
+
+        it = start_steps + step
+        if (lr_schedule_values is not None or wd_schedule_values is not None) and data_iter_step % update_freq == 0:
+            for param_group in optimizer.param_groups:
+                if lr_schedule_values is not None:
+                    if "lr_scale" in param_group:
+                        param_group["lr"] = lr_schedule_values[it] * param_group["lr_scale"]
+                    else:
+                        param_group["lr"] = lr_schedule_values[it]
+                if wd_schedule_values is not None and param_group["weight_decay"] > 0:
+                    param_group["weight_decay"] = wd_schedule_values[it]
+
+        samples = samples.to(device, non_blocking=True)
+        hard_targets = targets.to(device, non_blocking=True)
+        masks = masks.to(device, non_blocking=True)
+
+        samples_for_loss = samples
+        targets_for_loss = hard_targets
+        if mixup_fn is not None:
+            samples_for_loss, targets_for_loss = mixup_fn(samples_for_loss, hard_targets)
+
+        with torch.cuda.amp.autocast(enabled=torch.cuda.is_available() and not disable_amp):
+            outputs = model(samples_for_loss, return_patch_tokens=True)
+            logits = outputs["logits"]
+            patch_tokens = outputs["patch_tokens"]
+            seg_logits = outputs["seg_logits"]
+
+            cls_loss = criterion(logits, targets_for_loss)
+            resized_masks = F.interpolate(masks.float(), size=seg_logits.shape[-2:], mode="nearest")
+            resized_masks = (resized_masks > 0.5).float()
+            seg_loss, bce_loss, dice_loss = compute_seg_loss(seg_logits, resized_masks, loss_type=seg_loss_type)
+
+            if use_ha_loss and ha_lambda > 0.0:
+                patch_tokens_for_ha = outputs.get("gated_patch_tokens")
+                if patch_tokens_for_ha is None:
+                    patch_tokens_for_ha = patch_tokens
+                patch_map = build_cls_patch_map(model, patch_tokens_for_ha, hard_targets)
+                ha_masks = resized_masks.squeeze(1)
+                ha_loss = compute_ha_loss(
+                    patch_map,
+                    ha_masks,
+                    loss_type=ha_loss_type,
+                    fp_weight=ha_fp_weight,
+                )
+            else:
+                ha_loss = cls_loss.new_tensor(0.0)
+
+            loss = cls_loss + seg_lambda * seg_loss + ha_lambda * ha_loss
+
+        if debug_batches > 0 and epoch == 0 and data_iter_step < debug_batches:
+            with torch.no_grad():
+                seg_prob = torch.sigmoid(seg_logits.detach())
+                print("\n[MULTITASK DEBUG]")
+                print(f"epoch={epoch}, batch={data_iter_step}")
+                print("image tensor shape:", tuple(samples.shape))
+                print("mask tensor shape:", tuple(masks.shape))
+                print("logits shape:", tuple(logits.shape))
+                print("patch_tokens shape:", tuple(patch_tokens.shape))
+                print("segmentation logits shape:", tuple(seg_logits.shape))
+                print("seg_gate enabled:", outputs.get("seg_gate") is not None)
+                if outputs.get("seg_gate") is not None:
+                    gate_debug = outputs["seg_gate"].detach()
+                    print(
+                        "seg_gate min/max/mean:",
+                        float(gate_debug.min().cpu()),
+                        float(gate_debug.max().cpu()),
+                        float(gate_debug.mean().cpu()),
+                    )
+                print("resized mask shape:", tuple(resized_masks.shape))
+                print("cls_loss:", float(cls_loss.detach().cpu()))
+                print("BCE loss:", float(bce_loss.detach().cpu()))
+                print("Dice loss:", float(dice_loss.detach().cpu()))
+                print("seg_loss:", float(seg_loss.detach().cpu()))
+                print("ha_loss:", float(ha_loss.detach().cpu()))
+                print("total_loss:", float(loss.detach().cpu()))
+                print(
+                    "segmentation prediction min/max/mean:",
+                    float(seg_prob.min().cpu()),
+                    float(seg_prob.max().cpu()),
+                    float(seg_prob.mean().cpu()),
+                )
+                print(
+                    "mask min/max/mean:",
+                    float(resized_masks.min().cpu()),
+                    float(resized_masks.max().cpu()),
+                    float(resized_masks.mean().cpu()),
+                )
+                print(
+                    "NOTE: Debug prints are only for smoke testing. "
+                    "For normal runs, use --debug_batches 0."
+                )
+
+            if save_debug_seg_vis:
+                save_debug_seg_visuals(samples, masks, seg_logits, image_ids, output_dir, epoch, data_iter_step)
+
+        loss_value = loss.item()
+        if not math.isfinite(loss_value):
+            print(f"Loss is {loss_value}, stopping training")
+            raise RuntimeError("Non-finite loss")
+
+        loss = loss / update_freq
+        if disable_amp:
+            loss.backward()
+            if (data_iter_step + 1) % update_freq == 0:
+                if max_norm and max_norm > 0:
+                    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm)
+                optimizer.step()
+                optimizer.zero_grad()
+            grad_norm = None
+        else:
+            is_second_order = hasattr(optimizer, "is_second_order") and optimizer.is_second_order
+            grad_norm = loss_scaler(
+                loss,
+                optimizer,
+                clip_grad=max_norm,
+                parameters=model.parameters(),
+                create_graph=is_second_order,
+                update_grad=(data_iter_step + 1) % update_freq == 0,
+            )
+
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
+
+        metric_logger.update(loss=loss_value)
+        metric_logger.update(cls_loss=cls_loss.item())
+        metric_logger.update(seg_loss=seg_loss.item())
+        metric_logger.update(bce_loss=bce_loss.item())
+        metric_logger.update(dice_loss=dice_loss.item())
+        metric_logger.update(ha_loss=ha_loss.item())
+        if grad_norm is not None:
+            metric_logger.update(grad_norm=grad_norm)
+        max_lr = max(group["lr"] for group in optimizer.param_groups)
+        metric_logger.update(lr=max_lr)
+
+    metric_logger.synchronize_between_processes()
+    print("Averaged stats:", metric_logger)
+    return {k: meter.global_avg for k, meter in metric_logger.meters.items()}
+
+
+def cosine_scheduler(base_value, final_value, epochs, niter_per_ep, warmup_epochs=0, start_warmup_value=0):
+    warmup_schedule = np.array([])
+    warmup_iters = warmup_epochs * niter_per_ep
+    if warmup_epochs > 0:
+        warmup_schedule = np.linspace(start_warmup_value, base_value, warmup_iters)
+
+    iters = np.arange(epochs * niter_per_ep - warmup_iters)
+    schedule = np.array(
+        [
+            final_value + 0.5 * (base_value - final_value) * (1 + math.cos(math.pi * i / len(iters)))
+            for i in iters
+        ]
+    )
+    schedule = np.concatenate((warmup_schedule, schedule))
+    assert len(schedule) == epochs * niter_per_ep
+    return schedule
+
