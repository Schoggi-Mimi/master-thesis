+def train_one_epoch_softmask(
+    model,
+    criterion,
+    data_loader,
+    optimizer,
+    device,
+    epoch,
+    loss_scaler,
+    max_norm=0,
+    model_ema=None,
+    mixup_fn=None,
+    log_writer=None,
+    start_steps=None,
+    lr_schedule_values=None,
+    wd_schedule_values=None,
+    num_training_steps_per_epoch=None,
+    update_freq=None,
+    disable_amp=False,
+):
+    model.train(True)
+    metric_logger = utils.MetricLogger(delimiter="  ")
+    metric_logger.add_meter("lr", utils.SmoothedValue(window_size=1, fmt="{value:.8f}"))
+    metric_logger.add_meter("min_lr", utils.SmoothedValue(window_size=1, fmt="{value:.8f}"))
+    header = f"Epoch: [{epoch}]"
+    print_freq = 200
+
+    optimizer.zero_grad()
+    def _grad_norm(parameters):
+        grads = [p.grad.detach().float().norm(2) for p in parameters if p.grad is not None]
+        if len(grads) == 0:
+            return 0.0
+        return torch.norm(torch.stack(grads), 2).item()
+    debug_head_update = getattr(data_loader, "debug_head_update", False)
+    head_before = None
+    first_update_seen = False
+
+    if debug_head_update and epoch == 0:
+        head_params = [(n, p) for n, p in model.named_parameters() if "head" in n and p.requires_grad]
+        head_before = {n: p.detach().float().cpu().clone() for n, p in head_params}
+
+        print("DEBUG head before first update:")
+        for n, p in head_params:
+            print(
+                f"  {n}: mean={p.data.mean().item():.6f}, "
+                f"std={p.data.std().item():.6f}, "
+                f"norm={p.data.norm().item():.6f}"
+            )
+
+    for data_iter_step, batch in enumerate(metric_logger.log_every(data_loader, print_freq, header)):
+        samples, _, targets, masks = batch
+        step = data_iter_step // update_freq
+        if step >= num_training_steps_per_epoch:
+            continue
+        it = start_steps + step
+
+        if (lr_schedule_values is not None or wd_schedule_values is not None) and data_iter_step % update_freq == 0:
+            for param_group in optimizer.param_groups:
+                if lr_schedule_values is not None:
+                    if "lr_scale" in param_group:
+                        param_group["lr"] = lr_schedule_values[it] * param_group["lr_scale"]
+                    else:
+                        param_group["lr"] = lr_schedule_values[it]
+                if wd_schedule_values is not None and param_group["weight_decay"] > 0:
+                    param_group["weight_decay"] = wd_schedule_values[it]
+
+        samples = samples.to(device, non_blocking=True)
+        targets = targets.to(device, non_blocking=True)
+        masks = masks.to(device, non_blocking=True)
+
+        if mixup_fn is not None:
+            samples, targets = mixup_fn(samples, targets)
+
+        with torch.cuda.amp.autocast(enabled=not disable_amp):
+            outputs = model(samples, mask=masks)
+            loss = criterion(outputs, targets)
+
+        if getattr(data_loader, "debug_first_batch", False) and epoch == 0 and data_iter_step == 0:
+            with torch.no_grad():
+                mask_area = masks.float().mean(dim=(1, 2, 3)).detach().cpu().numpy()
+                target_hist = torch.bincount(
+                    targets.detach().cpu(),
+                    minlength=outputs.shape[1]
+                ).tolist()
+                pred_hist = torch.bincount(
+                    outputs.argmax(dim=1).detach().cpu(),
+                    minlength=outputs.shape[1]
+                ).tolist()
+
+                print("DEBUG first batch:")
+                print(f"  samples shape: {tuple(samples.shape)}")
+                print(f"  masks shape: {tuple(masks.shape)}")
+                print(
+                    f"  mask area mean/min/max: "
+                    f"{mask_area.mean():.4f}/{mask_area.min():.4f}/{mask_area.max():.4f}"
+                )
+                print(f"  target hist: {target_hist}")
+                print(f"  pred hist: {pred_hist}")
+                print(
+                    f"  logits mean/std/min/max: "
+                    f"{outputs.mean().item():.4f}/"
+                    f"{outputs.std().item():.4f}/"
+                    f"{outputs.min().item():.4f}/"
+                    f"{outputs.max().item():.4f}"
+                )
+
+        loss_value = loss.item()
+        if not np.isfinite(loss_value):
+            print(f"Loss is {loss_value}, stopping training")
+            raise RuntimeError("Non-finite loss")
+
+        if disable_amp:
+            loss_to_backward = loss / update_freq
+            loss_to_backward.backward()
+
+            if (data_iter_step + 1) % update_freq == 0:
+                if debug_head_update and not first_update_seen and head_before is not None:
+                    print("DEBUG head grad before first optimizer update:")
+                    for n, p in [(n, p) for n, p in model.named_parameters() if "head" in n and p.requires_grad]:
+                        grad_norm_head = 0.0 if p.grad is None else p.grad.detach().float().norm().item()
+                        print(f"  {n}: grad_norm={grad_norm_head:.8f}")
+
+                if max_norm and max_norm > 0:
+                    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm)
+                grad_norm = _grad_norm([p for p in model.parameters() if p.requires_grad])
+                optimizer.step()
+                optimizer.zero_grad()
+                if model_ema is not None:
+                    model_ema.update(model)
+
+                if debug_head_update and not first_update_seen and head_before is not None:
+                    first_update_seen = True
+                    print("DEBUG head after first optimizer update:")
+                    for n, p in [(n, p) for n, p in model.named_parameters() if "head" in n and p.requires_grad]:
+                        before = head_before[n].to(p.device)
+                        delta = (p.detach().float() - before).norm().item()
+                        print(
+                            f"  {n}: mean={p.data.mean().item():.6f}, "
+                            f"std={p.data.std().item():.6f}, "
+                            f"norm={p.data.norm().item():.6f}, "
+                            f"delta_norm={delta:.8f}"
+                        )
+            else:
+                grad_norm = None
+            loss_scale_value = 1.0
+        else:
+            is_second_order = hasattr(optimizer, "is_second_order") and optimizer.is_second_order
+            loss = loss / update_freq
+            grad_norm = loss_scaler(
+                loss,
+                optimizer,
+                clip_grad=max_norm,
+                parameters=model.parameters(),
+                create_graph=is_second_order,
+                update_grad=(data_iter_step + 1) % update_freq == 0,
+            )
+            if (data_iter_step + 1) % update_freq == 0:
+                optimizer.zero_grad()
+                if model_ema is not None:
+                    model_ema.update(model)
+                if debug_head_update and not first_update_seen and head_before is not None:
+                    first_update_seen = True
+                    print("DEBUG head after first optimizer update:")
+                    for n, p in [(n, p) for n, p in model.named_parameters() if "head" in n and p.requires_grad]:
+                        before = head_before[n].to(p.device)
+                        delta = (p.detach().float() - before).norm().item()
+                        print(
+                            f"  {n}: mean={p.data.mean().item():.6f}, "
+                            f"std={p.data.std().item():.6f}, "
+                            f"norm={p.data.norm().item():.6f}, "
+                            f"delta_norm={delta:.8f}"
+                        )
+            loss_scale_value = loss_scaler.state_dict()["scale"]
+
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
+
+        if mixup_fn is None:
+            class_acc = (outputs.max(-1)[-1] == targets).float().mean()
+        else:
+            class_acc = None
+
+        metric_logger.update(loss=loss_value)
+        metric_logger.update(class_acc=class_acc)
+        metric_logger.update(loss_scale=loss_scale_value)
+        metric_logger.update(grad_norm=grad_norm)
+
+        min_lr = min(group["lr"] for group in optimizer.param_groups)
+        max_lr = max(group["lr"] for group in optimizer.param_groups)
+        metric_logger.update(lr=max_lr)
+        metric_logger.update(min_lr=min_lr)
+
+        weight_decay_value = None
+        for group in optimizer.param_groups:
+            if group["weight_decay"] > 0:
+                weight_decay_value = group["weight_decay"]
+        metric_logger.update(weight_decay=weight_decay_value)
+
+        if log_writer is not None:
+            log_writer.update(loss=loss_value, head="loss")
+            log_writer.update(class_acc=class_acc, head="loss")
+            log_writer.update(loss_scale=loss_scale_value, head="opt")
+            log_writer.update(lr=max_lr, head="opt")
+            log_writer.update(min_lr=min_lr, head="opt")
+            log_writer.update(weight_decay=weight_decay_value, head="opt")
+            log_writer.update(grad_norm=grad_norm, head="opt")
+            log_writer.set_step()
+
+    metric_logger.synchronize_between_processes()
+    now_time = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime())
+    print(now_time, "Averaged stats:", metric_logger)
+    return {k: meter.global_avg for k, meter in metric_logger.meters.items()}
+
+
+@torch.no_grad()
+def evaluate_softmask(data_loader, model, device, out_dir, epoch, mode, num_class):
+    criterion = torch.nn.CrossEntropyLoss()
+    metric_logger = utils.MetricLogger(delimiter="  ")
+    header = "Test:"
+
+    prediction_decode_list = []
+    prediction_list = []
+    true_label_decode_list = []
+    true_label_onehot_list = []
+    image_names = []
+
+    model.eval()
+
+    for batch in metric_logger.log_every(data_loader, 9999, header):
+        images, ids, target, masks = batch
+        image_names.extend(ids)
+
+        images = images.to(device, non_blocking=True)
+        target = target.to(device, non_blocking=True)
+        masks = masks.to(device, non_blocking=True)
+
+        true_label = torch.nn.functional.one_hot(target.to(torch.int64), num_classes=num_class)
+
+        with torch.cuda.amp.autocast():
+            output = model(images, mask=masks)
+            loss = criterion(output, target)
+
+        acc1 = (output.argmax(dim=1) == target).float().mean()
+
+        probs = torch.softmax(output, dim=1)
+        prediction_list.extend(probs.detach().cpu().numpy())
+        prediction_decode_list.extend(output.argmax(dim=1).detach().cpu().numpy())
+        true_label_decode_list.extend(target.detach().cpu().numpy())
+        true_label_onehot_list.extend(true_label.detach().cpu().numpy())
+
+        batch_size = images.shape[0]
+        metric_logger.update(loss=loss.item())
+        metric_logger.meters["acc1"].update(acc1.item(), n=batch_size)
+
+    metric_logger.synchronize_between_processes()
+    print("-------------", mode, "-------------")
+
+    from sklearn.metrics import balanced_accuracy_score, accuracy_score, roc_auc_score, f1_score, recall_score, confusion_matrix, top_k_accuracy_score, multilabel_confusion_matrix
+
+    prediction_list = np.array(prediction_list)
+    prediction_decode_list = np.array(prediction_decode_list)
+    true_label_decode_list = np.array(true_label_decode_list)
+    true_label_onehot_list = np.array(true_label_onehot_list)
+
+    pred_hist = np.bincount(
+        prediction_decode_list.astype(int),
+        minlength=num_class
+    ).tolist()
+
+    true_hist = np.bincount(
+        true_label_decode_list.astype(int),
+        minlength=num_class
+    ).tolist()
+
+    print(f"{mode} true hist: {true_hist}")
+    print(f"{mode} pred hist: {pred_hist}")
+
+    bacc = balanced_accuracy_score(true_label_decode_list, prediction_decode_list)
+    acc = accuracy_score(true_label_decode_list, prediction_decode_list)
+    recall_macro = recall_score(true_label_decode_list, prediction_decode_list, average="macro")
+    recall_weighted = recall_score(true_label_decode_list, prediction_decode_list, average="weighted")
+    w_f1 = f1_score(true_label_decode_list, prediction_decode_list, average="weighted")
+
+    try:
+        auc_roc = roc_auc_score(true_label_onehot_list, prediction_list, multi_class="ovr")
+    except Exception:
+        auc_roc = -1.0
+
+    print(
+        f"Sklearn Metrics - BAcc: {bacc:.4f} "
+        f"Acc: {acc:.4f} "
+        f"Recall_macro: {recall_macro:.4f} "
+        f"Recall_weighted: {recall_weighted:.4f} "
+        f"AUC-ROC: {auc_roc:.4f} "
+        f"Weighted F1-score: {w_f1:.4f}"
+    )
+
+    os.makedirs(out_dir, exist_ok=True)
+    csv_path = os.path.join(out_dir, f"{mode}.csv")
+    probs_header = [f"probability_class_{i}" for i in range(num_class)]
+
+    import csv
+    with open(csv_path, "w", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(["filename", "true_label", "predicted_label"] + probs_header)
+        for name, y_true, y_pred, probs in zip(image_names, true_label_decode_list, prediction_decode_list, prediction_list):
+            writer.writerow([name, int(y_true), int(y_pred)] + [f"{p:.8f}" for p in probs])
+
+    # print(f"Predictions for {mode} saved to {csv_path}")
+
+    stats = {
+        "Epoch": epoch,
+        f"{mode.capitalize()} Loss": metric_logger.loss.global_avg,
+        f"{mode.capitalize()} BAcc": bacc,
+        f"{mode.capitalize()} Acc": acc,
+        f"{mode.capitalize()} ROC": auc_roc,
+        f"{mode.capitalize()} W_F1": w_f1,
+        f"{mode.capitalize()} Recall_macro": recall_macro,
+        f"{mode.capitalize()} Recall_weighted": recall_weighted,
+    }
+    # print("--------------------------", stats)
+    return stats
+
