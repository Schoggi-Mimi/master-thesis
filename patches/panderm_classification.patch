+    # print(
+    #     f"Soft-mask setup: mode={args.soft_mask_mode}, bg_strength={args.bg_strength}, "
+    #     f"sampler={args.weights}, class_weights={args.class_weights}"
+    # )
+
+    mixup_fn = None
