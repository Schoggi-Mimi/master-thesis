+class PatchSegHead(nn.Module):
+    def __init__(self, embed_dim, hidden_dim=None):
+        super().__init__()
+        hidden_dim = hidden_dim or max(embed_dim // 2, 128)
+        self.head = nn.Sequential(
+            nn.LayerNorm(embed_dim),
+            nn.Linear(embed_dim, hidden_dim),
+            nn.GELU(),
+            nn.Linear(hidden_dim, 1),
+        )
+
+    def forward(self, patch_tokens, patch_hw):
+        b, n, _ = patch_tokens.shape
+        h, w = patch_hw
+        if n != h * w:
+            raise ValueError(f"patch token count {n} does not match patch grid {h}x{w}")
+        seg_logits = self.head(patch_tokens).transpose(1, 2).reshape(b, 1, h, w)
+        return seg_logits
+
+
+class PanDermMultitaskSegWrapper(nn.Module):
+    def __init__(
+        self,
+        backbone,
+        use_seg_gate=False,
+        seg_gate_bg_keep=0.15,
+        seg_gate_detach=True,
+    ):
+        super().__init__()
+        self.backbone = backbone
+        self.seg_head = PatchSegHead(embed_dim=backbone.embed_dim)
+        self.use_seg_gate = use_seg_gate
+        self.seg_gate_bg_keep = seg_gate_bg_keep
+        self.seg_gate_detach = seg_gate_detach
+
+    def classify_from_patch_tokens(self, patch_tokens):
+        """
+        Reuse the PanDerm classification head, but classify from patch tokens directly.
+
+        This is needed for the gated experiment:
+        patch tokens -> segmentation mask gate -> gated patch tokens -> classifier.
+        """
+        if hasattr(self.backbone, "fc_norm") and self.backbone.fc_norm is not None:
+            pooled = patch_tokens.mean(dim=1)
+            pooled = self.backbone.fc_norm(pooled)
+        elif hasattr(self.backbone, "norm") and self.backbone.norm is not None:
+            pooled = patch_tokens.mean(dim=1)
+            pooled = self.backbone.norm(pooled)
+        else:
+            pooled = patch_tokens.mean(dim=1)
+
+        logits = self.backbone.head(pooled)
+        return logits
+
+    def forward(self, x, return_patch_tokens=True):
+        outputs = self.backbone(x, return_patch_tokens=True)
+        raw_logits, patch_tokens = unpack_model_outputs(outputs)
+
+        if patch_tokens is None:
+            raise ValueError(
+                "The PanDerm backbone did not return patch tokens. "
+                "Check that modeling_finetune.py supports return_patch_tokens=True."
+            )
+
+        patch_hw = self.backbone.patch_embed.patch_shape
+        seg_logits = self.seg_head(patch_tokens, patch_hw)
+
+        if self.use_seg_gate:
+            seg_prob = torch.sigmoid(seg_logits)
+
+            if self.seg_gate_detach:
+                seg_prob_for_gate = seg_prob.detach()
+            else:
+                seg_prob_for_gate = seg_prob
+
+            b, _, h, w = seg_prob_for_gate.shape
+
+            gate = seg_prob_for_gate.reshape(b, 1, h * w).transpose(1, 2)
+            gate = self.seg_gate_bg_keep + (1.0 - self.seg_gate_bg_keep) * gate
+
+            gated_patch_tokens = patch_tokens * gate
+            logits = self.classify_from_patch_tokens(gated_patch_tokens)
+        else:
+            gate = None
+            gated_patch_tokens = None
+            logits = raw_logits
+
+        return {
+            "logits": logits,
+            "raw_logits": raw_logits,
+            "patch_tokens": patch_tokens,
+            "gated_patch_tokens": gated_patch_tokens,
+            "seg_logits": seg_logits,
+            "seg_gate": gate,
+        }
