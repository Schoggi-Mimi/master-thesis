+def denormalize_image_tensor(x):
+    mean = torch.tensor([0.485, 0.456, 0.406], device=x.device).view(3, 1, 1)
+    std = torch.tensor([0.229, 0.224, 0.225], device=x.device).view(3, 1, 1)
+    return torch.clamp(x * std + mean, 0.0, 1.0)
