+def minmax_normalize_map(attn_map, eps=1e-6):
+    b = attn_map.shape[0]
+    flat = attn_map.view(b, -1)
+    min_v = flat.min(dim=1, keepdim=True)[0].view(b, 1, 1)
+    max_v = flat.max(dim=1, keepdim=True)[0].view(b, 1, 1)
+    return (attn_map - min_v) / (max_v - min_v + eps)
+
