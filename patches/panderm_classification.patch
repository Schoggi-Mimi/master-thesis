+class CropMaskTransform:
+    def __init__(
+        self,
+        input_size=224,
+        train=True,
+        margin=0.25,
+        min_crop_frac=0.30,
+        mean=None,
+        std=None,
+    ):
+        self.input_size = input_size
+        self.train = train
+        self.margin = margin
+        self.min_crop_frac = min_crop_frac
+        self.mean = mean or [0.485, 0.456, 0.406]
+        self.std = std or [0.228, 0.224, 0.225]
+
+    def _mask_bbox(self, mask):
+        mask_np = np.array(mask)
+        if mask_np.ndim == 3:
+            mask_np = mask_np[..., 0]
+        mask_bin = mask_np > 0
+
+        if not mask_bin.any():
+            w, h = mask.size
+            return 0, 0, w, h
+
+        ys, xs = np.where(mask_bin)
+        x0 = int(xs.min())
+        x1 = int(xs.max()) + 1
+        y0 = int(ys.min())
+        y1 = int(ys.max()) + 1
+        return x0, y0, x1, y1
+
+    def _expand_and_square_bbox(self, bbox, image_size):
+        x0, y0, x1, y1 = bbox
+        w_img, h_img = image_size
+
+        box_w = max(1, x1 - x0)
+        box_h = max(1, y1 - y0)
+        cx = 0.5 * (x0 + x1)
+        cy = 0.5 * (y0 + y1)
+
+        side = max(box_w, box_h)
+        side = side * (1.0 + 2.0 * self.margin)
+        side = max(side, self.min_crop_frac * min(w_img, h_img))
+        side = min(side, max(w_img, h_img))
+
+        new_x0 = int(round(cx - side / 2.0))
+        new_y0 = int(round(cy - side / 2.0))
+        new_x1 = int(round(cx + side / 2.0))
+        new_y1 = int(round(cy + side / 2.0))
+
+        if new_x0 < 0:
+            new_x1 -= new_x0
+            new_x0 = 0
+        if new_y0 < 0:
+            new_y1 -= new_y0
+            new_y0 = 0
+        if new_x1 > w_img:
+            shift = new_x1 - w_img
+            new_x0 -= shift
+            new_x1 = w_img
+        if new_y1 > h_img:
+            shift = new_y1 - h_img
+            new_y0 -= shift
+            new_y1 = h_img
+
+        new_x0 = max(0, new_x0)
+        new_y0 = max(0, new_y0)
+        new_x1 = min(w_img, new_x1)
+        new_y1 = min(h_img, new_y1)
+
+        if new_x1 <= new_x0 or new_y1 <= new_y0:
+            return 0, 0, w_img, h_img
+
+        return new_x0, new_y0, new_x1, new_y1
+
+    def __call__(self, image, mask):
+        bbox = self._mask_bbox(mask)
+        crop_box = self._expand_and_square_bbox(bbox, image.size)
+        x0, y0, x1, y1 = crop_box
+
+        image = image.crop((x0, y0, x1, y1))
+        mask = mask.crop((x0, y0, x1, y1))
+
+        image = TF.resize(
+            image,
+            (self.input_size, self.input_size),
+            interpolation=InterpolationMode.BILINEAR,
+            antialias=True,
+        )
+        mask = TF.resize(
+            mask,
+            (self.input_size, self.input_size),
+            interpolation=InterpolationMode.NEAREST,
+        )
+
+        if self.train:
+            if torch.rand(1).item() < 0.5:
+                image = TF.hflip(image)
+                mask = TF.hflip(mask)
+
+            angle = float(torch.empty(1).uniform_(-10.0, 10.0).item())
+            image = TF.rotate(
+                image,
+                angle,
+                interpolation=InterpolationMode.BILINEAR,
+                fill=0,
+            )
+            mask = TF.rotate(
+                mask,
+                angle,
+                interpolation=InterpolationMode.NEAREST,
+                fill=0,
+            )
+
+            if torch.rand(1).item() < 0.5:
+                brightness = float(torch.empty(1).uniform_(0.95, 1.05).item())
+                contrast = float(torch.empty(1).uniform_(0.95, 1.05).item())
+                saturation = float(torch.empty(1).uniform_(0.95, 1.05).item())
+                hue = float(torch.empty(1).uniform_(-0.02, 0.02).item())
+                image = TF.adjust_brightness(image, brightness)
+                image = TF.adjust_contrast(image, contrast)
+                image = TF.adjust_saturation(image, saturation)
+                image = TF.adjust_hue(image, hue)
+
+        image = TF.to_tensor(image)
+        image = TF.normalize(image, mean=self.mean, std=self.std)
+
+        mask = TF.to_tensor(mask)
+        mask = (mask > 0.5).float()
+        if mask.shape[0] > 1:
+            mask = mask[:1]
+
+        return image, mask
+
+
+class UniCropMaskDataset(torch.utils.data.Dataset):
+    def __init__(
+        self,
+        df,
+        root,
+        train=False,
+        val=False,
+        test=False,
+        transform=None,
+        binary=False,
+        data_percent=1.0,
+        image_key="image_rel_path",
+        mask_key="mask_rel_path",
+        image_id_key="image_id",
+    ):
+        if train:
+            self.df = df[df["split"] == "train"].copy()
+            keep_rows = int(len(self.df) * data_percent)
+            self.df = self.df.head(keep_rows)
+        elif val:
+            self.df = df[df["split"] == "val"].copy()
+        elif test:
+            self.df = df[df["split"] == "test"].copy()
+        else:
+            self.df = df.copy()
+
+        self.root = Path(root)
+        self.transform = transform
+        self.binary = binary
+        self.image_key = image_key
+        self.mask_key = mask_key
+        self.image_id_key = image_id_key
+
+    def __getitem__(self, index):
+        row = self.df.iloc[index]
+
+        image_rel = row[self.image_key]
+        mask_rel = row[self.mask_key]
+        image_path = (self.root / str(image_rel)).resolve()
+        mask_path = (self.root / str(mask_rel)).resolve()
+
+        try:
+            image = Image.open(image_path).convert("RGB")
+        except IOError as e:
+            raise RuntimeError(f"Failed to open image: {image_path}") from e
+
+        try:
+            mask = Image.open(mask_path).convert("L")
+        except IOError as e:
+            raise RuntimeError(f"Failed to open mask: {mask_path}") from e
+
+        if self.transform is not None:
+            image, mask = self.transform(image, mask)
+        else:
+            image = TF.to_tensor(image)
+            mask = (TF.to_tensor(mask) > 0.5).float()
+            if mask.shape[0] > 1:
+                mask = mask[:1]
+
+        if self.binary:
+            y = row["binary_label"]
+        else:
+            y = row["label"]
+
+        image_id = row[self.image_id_key] if self.image_id_key in row else Path(str(image_rel)).stem
+        return {"image": image, "image_id": str(image_id), "label": int(y), "mask": mask}
+
+    def __len__(self):
+        return len(self.df)
+
+    def count_label(self):
+        return self.df["label"].value_counts().sort_index()
+
+
+def cropmask_collate_fn(batch):
+    images = torch.stack([b["image"] for b in batch], dim=0)
+    labels = torch.tensor([b["label"] for b in batch], dtype=torch.long)
+    ids = [b["image_id"] for b in batch]
+    masks = torch.stack([b["mask"] for b in batch], dim=0)
+    return images, ids, labels, masks
