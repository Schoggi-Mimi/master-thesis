+def dice_loss_from_logits(seg_logits, target, eps=1e-6):
+    pred = torch.sigmoid(seg_logits).float()
+    target = target.float()
+    intersection = (pred * target).sum(dim=(1, 2, 3))
+    denom = pred.sum(dim=(1, 2, 3)) + target.sum(dim=(1, 2, 3))
+    dice = (2.0 * intersection + eps) / (denom + eps)
+    return 1.0 - dice.mean()
+
+
+def compute_seg_loss(seg_logits, target, loss_type="bce_dice"):
+    bce = F.binary_cross_entropy_with_logits(seg_logits.float(), target.float())
+    dice = dice_loss_from_logits(seg_logits, target)
+    if loss_type == "bce":
+        return bce, bce, dice
+    if loss_type == "dice":
+        return dice, bce, dice
+    if loss_type == "bce_dice":
+        return bce + dice, bce, dice
+    raise ValueError(f"Unsupported seg_loss_type: {loss_type}")
+
+
+def ha_soft_dice_loss(pred, target, eps=1e-6):
+    pred = pred.float()
+    target = target.float()
+    intersection = (pred * target).sum(dim=(1, 2))
+    denom = pred.sum(dim=(1, 2)) + target.sum(dim=(1, 2))
+    dice = (2.0 * intersection + eps) / (denom + eps)
+    return 1.0 - dice.mean()
+
+
+def ha_alignment_loss(pred, target, fp_weight=1.0, eps=1e-6):
+    pred = pred.float()
+    target = target.float()
+    inside_mass = (pred * target).sum(dim=(1, 2))
+    outside_mass = (pred * (1.0 - target)).sum(dim=(1, 2))
+    target_area = target.sum(dim=(1, 2))
+    background_area = (1.0 - target).sum(dim=(1, 2))
+    inside_mean = inside_mass / (target_area + eps)
+    outside_mean = outside_mass / (background_area + eps)
+    return ((1.0 - inside_mean) + fp_weight * outside_mean).mean()
+
+
+def compute_ha_loss(pred, target, loss_type="paper_dice", fp_weight=1.0, eps=1e-6):
+    if loss_type == "paper_dice":
+        return ha_soft_dice_loss(pred, target, eps=eps)
+    if loss_type == "alignment":
+        return ha_alignment_loss(pred, target, fp_weight=fp_weight, eps=eps)
+    raise ValueError(f"Unsupported ha_loss_type: {loss_type}")
+
